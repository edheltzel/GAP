{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "SUPERSET_AGENT_ID=codex \"/Users/ed/.superset/hooks/notify.sh\"",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash '/Users/ed/.codex/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "SUPERSET_AGENT_ID=codex \"/Users/ed/.superset/hooks/notify.sh\"",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "SUPERSET_AGENT_ID=codex \"/Users/ed/.superset/hooks/notify.sh\"",
            "type": "command"
          }
        ]
      }
    ]
  }
}