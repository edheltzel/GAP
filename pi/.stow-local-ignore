# Stow defaults (REQUIRED — this file replaces built-in defaults)
\.git
\.gitignore
\.gitmodules
\.gitattributes
.+~
\#.*\#

# macOS
\.DS_Store

# Dependencies
node_modules

# Templates (not needed at runtime)
\.env\.example

# Pi runtime state (live versions are written by Pi itself; never link from atlas-config)
\.pi/agent/auth\.json
\.pi/agent/autoresearch\.jsonl
\.pi/agent/mcp\.json
\.pi/agent/mcp-cache\.json
\.pi/agent/run-history\.jsonl
\.pi/agent/\.update-check
\.pi/agent/cache(/.*)?
\.pi/agent/sessions(/.*)?
\.pi/agent/memory(/.*)?
# Skills installed via skills.sh / Compound Engineering are managed by Pi in ~/.pi/agent
\.pi/agent/agents/ce-.*\.md
\.pi/agent/skills/ce-[^/]+(/.*)?
\.pi/agent/skills/lfg(/.*)?
\.pi/agent/compound-engineering(/.*)?
\.pi/agent/.*\.lazypi\..*\.bak

# Pi package install caches/checkouts are reconstructed from settings.json packages
\.pi/agent/npm(/.*)?
\.pi/agent/git(/.*)?

# Recall-managed local links live in ~/.pi/agent, not in atlas-config
\.pi/agent/Recall_GUIDE\.md
\.pi/agent/extensions/Recall(Extract|PreCompact)\.ts

# Repo-only files (not needed in ~/.pi/)
