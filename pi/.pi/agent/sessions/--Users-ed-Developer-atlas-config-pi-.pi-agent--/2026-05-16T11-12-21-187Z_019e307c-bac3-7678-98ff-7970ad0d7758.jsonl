{"type":"custom","customType":"web-search-results","data":{"id":"mp8cxuok2336uw","type":"fetch","timestamp":1778936632724,"urls":[{"url":"https://github.com/badlogic/pi-mono/blob/main/packages/coding-agent/examples/extensions/commands.ts","title":"packages/coding-agent/examples/extensions/commands.ts at main · badlogic/pi-mono","content":"```ts\n/**\n * Commands Extension\n *\n * Demonstrates the pi.getCommands() API by providing a /commands command\n * that lists all available slash commands in the current session.\n *\n * Usage:\n * 1. Copy this file to ~/.pi/agent/extensions/ or your project's .pi/extensions/\n * 2. Use /commands to see available commands\n * 3. Use /commands extensions to filter by source\n */\n[...]\nimport type { ExtensionAPI, SlashCommandInfo } from \"@mariozechner/pi-coding-agent\";\n[...]\nexport default function commandsExtension(pi: ExtensionAPI) {\n\tpi.registerCommand(\"commands\", {\n\t\tdescription: \"List available slash commands\",\n\t\tgetArgumentCompletions: (prefix) => {\n\t\t\tconst sources = [\"extension\", \"prompt\", \"skill\"];\n\t\t\tconst filtered = sources.filter((s) => s.startsWith(prefix));\n\t\t\treturn filtered.length > 0 ? filtered.map((s) => ({ value: s, label: s })) : null;\n\t\t},\n\t\thandler: async (args, ctx) => {\n\t\t\tconst commands = pi.getCommands();\n\t\t\tconst sourceFilter = args.trim() as \"extension\" | \"prompt\" | \"skill\" | \"\";\n\n\t\t\t// Filter by source if specified\n\t\t\tconst filtered = sourceFilter ? commands.filter((c) => c.source === sourceFilter) : commands;\n\n\t\t\tif (filtered.length === 0) {\n\t\t\t\tctx.ui.notify(sourceFilter ? `No ${sourceFilter} commands found` : \"No commands found\", \"info\");\n\t\t\t\treturn;\n\t\t\t}\n\n\t\t\t// Build selection items grouped by source\n\t\t\tconst formatCommand = (cmd: SlashCommandInfo): string => {\n\t\t\t\tconst desc = cmd.description ? ` - ${cmd.description}` : \"\";\n\t\t\t\treturn `/${cmd.name}${desc}`;\n\t\t\t};\n\n\t\t\tconst items: string[] = [];\n\t\t\tconst sources: Array<{ key: \"extension\" | \"prompt\" | \"skill\"; label: string }> = [\n\t\t\t\t{ key: \"extension\", label: \"Extensions\" },\n\t\t\t\t{ key: \"prompt\", label: \"Prompts\" },\n\t\t\t\t{ key: \"skill\", label: \"Skills\" },\n\t\t\t];\n\n\t\t\tfor (const { key, label } of sources) {\n\t\t\t\tconst cmds = filtered.filter((c) => c.source === key);\n\t\t\t\tif (cmds.length > 0) {\n\t\t\t\t\titems.push(`--- ${label} ---`);\n\t\t\t\t\titems.push(...cmds.map(formatCommand));\n\t\t\t\t}\n\t\t\t}\n\n\t\t\t// Show in a selector (user can scroll and see all commands)\n\t\t\tconst selected = await ctx.ui.select(\"Available Commands\", items);\n\n\t\t\t// If user selected a command (not a header), offer to show its path\n\t\t\tif (selected && !selected.startsWith(\"---\")) {\n\t\t\t\tconst cmdName = selected.split(\" - \")[0].slice(1); // Remove leading /\n\t\t\t\tconst cmd = commands.find((c) => c.name === cmdName);\n\t\t\t\tif (cmd?.sourceInfo.path) {\n\t\t\t\t\tconst showPath = await ctx.ui.confirm(cmd.name, `View source path?\\n${cmd.sourceInfo.path}`);\n\t\t\t\t\tif (showPath) {\n\t\t\t\t\t\tctx.ui.notify(cmd.sourceInfo.path, \"info\");\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t},\n\t});\n}","error":null},{"url":"https://github.com/Dwsy/pi-extensions-skill/blob/main/PATTERNS.md","title":"PATTERNS.md at main · Dwsy/pi-extensions-skill","content":"```typescript\nimport type { ExtensionAPI } from \"@mariozechner/pi-coding-agent\";\n\nexport default function (pi: ExtensionAPI) {\n  pi.registerCommand(\"ping\", {\n    description: \"Ping the extension\",\n    handler: async (_args, ctx) => {\n      ctx.ui.notify(\"pong\", \"info\");\n    },\n  });\n}\n```\n[...]\n## P6. Command Registration\n[...]\n```typescript\npi.registerCommand(\"deploy\", {\n  description: \"Deploy to environment\",\n  handler: async (args, ctx) => {\n    const env = args.trim() || \"staging\";\n    ctx.ui.notify(`Deploying to ${env}...`, \"info\");\n  },\n});\n```\n[...]\n## P7. Command with Autocomplete\n[...]\n```typescript\nimport type { AutocompleteItem } from \"@mariozechner/pi-tui\";\n\npi.registerCommand(\"env\", {\n  description: \"Select environment\",\n  getArgumentCompletions: (prefix: string): AutocompleteItem[] | null => {\n    const envs = [\"dev\", \"staging\", \"prod\"];\n    const items = envs.map((e) => ({ value: e, label: e }));\n    const filtered = items.filter((i) => i.value.startsWith(prefix));\n    return filtered.length > 0 ? filtered : null;\n  },\n  handler: async (args, ctx) => {\n    ctx.ui.notify(`Selected: ${args || \"dev\"}`, \"info\");\n  },\n});\n[...]\n## P21. RPC-Safe Extension\n[...]\n```typescript\nexport default function (pi: ExtensionAPI) {\n  const isRPC = process.argv.includes(\"--mode\") && process.argv.includes(\"rpc\");\n\n  // Pure TUI extension: skip in RPC\n  if (isRPC) return;\n\n  // Mixed extension: use dialogs instead of custom() in RPC\n  pi.registerCommand(\"my-cmd\", {\n    handler: async (_args, ctx) => {\n      if (isRPC) {\n        const choice = await ctx.ui.select(\"Pick:\", [\"A\", \"B\"]);\n        // ...\n      } else {\n        const result = await ctx.ui.custom((tui, theme, kb, done) => {\n          // rich TUI\n        });\n        // ...\n      }\n    },\n  });\n}\n[...]\n## P23. Model Switch on Command\n[...]\n```typescript\npi.registerCommand(\"fast\", {\n  description: \"Switch to fast model\",\n  handler: async (_args, ctx) => {\n    const fast = ctx.modelRegistry.find(\"anthropic\", \"claude-haiku-4-5\");\n    if (!fast) {\n      ctx.ui.notify(\"Fast model not available\", \"error\");\n      return;\n    }\n    const ok = await pi.setModel(fast);\n    ctx.ui.notify(ok ? \"Switched to fast model\" : \"No API key\", ok ? \"success\" : \"error\");\n  },\n});","error":null},{"url":"https://pi.dev/docs/latest/extensions","title":"Extensions - Pi Coding Agent","content":"- Custom tools - Register tools the LLM can call via`pi.registerTool()`\n- Event interception - Block or modify tool calls, inject context, customize compaction\n- User interaction - Prompt users via`ctx.ui`(select, confirm, input, notify)\n- Custom UI components - Full TUI components with keyboard input via`ctx.ui.custom()` for complex interactions\n- Custom commands - Register commands like`/mycommand` via`pi.registerCommand()`\n- Session persistence - Store state that survives restarts via`pi.appendEntry()`\n- Custom rendering - Control how tool calls/results and messages appear in TUI\n[...]\nexport default function (\n[...]\n: ExtensionAPI) {\n  // React to events\n  pi.on(\"session_start\", async (_event, ctx) => {\n    ctx.ui.notify(\"Extension loaded!\", \"info\");\n  });\n\n  pi.on(\"tool_call\", async (event, ctx) => {\n    if (event.toolName === \"bash\" && event.input.command?.includes(\"rm -rf\")) {\n      const ok = await ctx.ui.confirm(\"Dangerous!\", \"Allow rm -rf?\");\n      if (!ok) return { block: true, reason: \"Blocked by user\" };\n    }\n  });\n\n  // Register a custom tool\n  pi.registerTool({\n    name: \"greet\",\n    label: \"Greet\",\n    description: \"Greet someone by name\",\n    parameters: Type.Object({\n      name: Type.String({ description: \"Name to greet\" }),\n    }),\n    async execute(toolCallId, params, signal, onUpdate, ctx) {\n      return {\n        content: [{ type: \"text\", text: `Hello, ${params.name}!` }],\n        details: {},\n      };\n    },\n  });\n\n  // Register a command\n  pi.registerCommand(\"hello\", {\n    description: \"Say hello\",\n    handler: async (args, ctx) => {\n      ctx.ui.notify(`Hello ${args || \"world\"}!`, \"info\");\n    },\n  });\n}\n[...]\nFor distributed pi packages installed with`pi install`(npm or git), runtime deps must be in`dependencies`. Package installation uses production installs (`npm install --omit=dev`) by default, so`devDependencies` are not available at runtime; when`npmCommand` is configured, git packages use plain`install` for compatibility with wrappers.\n[...]\nexport default function (pi: ExtensionAPI) {\n  // Subscribe to events\n  pi.on(\"event_name\", async (event, ctx) => {\n    // ctx.ui for user interaction\n    const ok = await ctx.ui.confirm(\"Title\", \"Are you sure?\");\n    ctx.ui.notify(\"Done!\", \"success\");\n    ctx.ui.setStatus(\"my-ext\", \"Processing...\");  // Footer status\n    ctx.ui.setWidget(\"my-ext\", [\"Line 1\", \"Line 2\"]);  // Widget above editor (default)\n  });\n\n  // Register tools, commands, shortcuts, flags\n  pi.registerTool({ ... });\n  pi.registerCommand(\"name\", { ... });\n  pi.registerShortcut(\"ctrl+x\", { ... });\n  pi.registerFlag(\"my-flag\", { ... });\n}\n[...]\nnpm install` in the\n[...]\ndirectory, then\n[...]\n_modules/` work\n[...]\npi.registerCommand(\"my-cmd\",\n[...]\n```\npi\n[...]\nregisterCommand(\"reload-runtime\n[...]\nhandler\n[...]\n},\n});\n[...]\nregisterCommand(\"\n[...]\nawait ctx.reload\n[...]\n},\n  });\n[...]\n.registerTool({\n    name\n[...]\n\",\n[...]\n\",\n[...]\n### pi.registerCommand(name, options)\n[...]\nIf multiple extensions register the same command name, pi keeps them all and assigns numeric invocation suffixes in load order, for example`/review:1` and`/review:2`.\n[...]\n```\npi.registerCommand(\"stats\", {\n  description: \"Show session statistics\",\n  handler: async (args, ctx) => {\n    const count = ctx.sessionManager.getEntries().length;\n    ctx.ui.notify(`${count} entries`, \"info\");\n  }\n});\n[...]\nOptional: add argument auto-completion for`/command ...`:\n[...]\n```\nimport type\n[...]\nocompleteItem } from\n[...]\npi.registerCommand(\"deploy\", {\n  description: \"Deploy to an environment\",\n  getArgumentCompletions: (prefix: string): AutocompleteItem[] | null => {\n    const envs = [\"dev\", \"staging\", \"prod\"];\n    const items = envs.map((e) => ({ value: e, label: e }));\n    const filtered = items.filter((i) => i.value.startsWith(prefix));\n    return filtered.length > 0 ? filtered : null;\n  },\n  handler: async (args, ctx) => {\n    ctx.ui.notify(`Deploying: ${args}`, \"info\");\n  },\n});","error":null},{"url":"https://github.com/earendil-works/pi/blob/main/packages/coding-agent/docs/extensions.md","title":"packages/coding-agent/docs/extensions.md at main · earendil-works/pi","content":"- **Custom tools** - Register tools the LLM can call via `pi.registerTool()`\n- **Event interception** - Block or modify tool calls, inject context, customize compaction\n- **User interaction** - Prompt users via `ctx.ui` (select, confirm, input, notify)\n- **Custom UI components** - Full TUI components with keyboard input via `ctx.ui.custom()` for complex interactions\n- **Custom commands** - Register commands like `/mycommand` via `pi.registerCommand()`\n- **Session persistence** - Store state that survives restarts via `pi.appendEntry()`\n- **Custom rendering** - Control how tool calls/results and messages appear in TUI\n[...]\nexport default function (\n[...]\n: ExtensionAPI) {\n  // React to events\n  pi.on(\"session_start\", async (_event, ctx) => {\n    ctx.ui.notify(\"Extension loaded!\", \"info\");\n  });\n\n  pi.on(\"tool_call\", async (event, ctx) => {\n    if (event.toolName === \"bash\" && event.input.command?.includes(\"rm -rf\")) {\n      const ok = await ctx.ui.confirm(\"Dangerous!\", \"Allow rm -rf?\");\n      if (!ok) return { block: true, reason: \"Blocked by user\" };\n    }\n  });\n\n  // Register a custom tool\n  pi.registerTool({\n    name: \"greet\",\n    label: \"Greet\",\n    description: \"Greet someone by name\",\n    parameters: Type.Object({\n      name: Type.String({ description: \"Name to greet\" }),\n    }),\n    async execute(toolCallId, params, signal, onUpdate, ctx) {\n      return {\n        content: [{ type: \"text\", text: `Hello, ${params.name}!` }],\n        details: {},\n      };\n    },\n  });\n\n  // Register a command\n  pi.registerCommand(\"hello\", {\n    description: \"Say hello\",\n    handler: async (args, ctx) => {\n      ctx.ui.notify(`Hello ${args || \"world\"}!`, \"info\");\n    },\n  });\n}\n[...]\nFor distributed pi packages installed with `pi install` (npm or git), runtime deps must be in `dependencies`. Package installation uses production installs (`npm install --omit=dev`) by default, so `devDependencies` are not available at runtime; when `npmCommand` is configured, git packages use plain `install` for compatibility with wrappers.\n[...]\nexport default function (pi: ExtensionAPI) {\n  // Subscribe to events\n  pi.on(\"event_name\", async (event, ctx) => {\n    // ctx.ui for user interaction\n    const ok = await ctx.ui.confirm(\"Title\", \"Are you sure?\");\n    ctx.ui.notify(\"Done!\", \"success\");\n    ctx.ui.setStatus(\"my-ext\", \"Processing...\");  // Footer status\n    ctx.ui.setWidget(\"my-ext\", [\"Line 1\", \"Line 2\"]);  // Widget above editor (default)\n  });\n\n  // Register tools, commands, shortcuts, flags\n  pi.registerTool({ ... });\n  pi.registerCommand(\"name\", { ... });\n  pi.registerShortcut(\"ctrl+x\", { ... });\n  pi.registerFlag(\"my-flag\", { ... });\n}\n[...]\nnpm install` in the extension directory, then\n[...]\n_modules/` work\n[...]\n```typescript\npi.registerCommand(\"my-cmd\", {\n[...]\n: async (args, ctx\n[...]\nawait ctx.waitForIdle();\n    // Agent is now idle, safe to modify session\n  },\n});\n[...]\n### pi.registerCommand(name, options)\n[...]\nIf multiple extensions register the same command name, pi keeps them all and assigns numeric invocation suffixes in load order, for example `/review:1` and `/review:2`.\n[...]\n```typescript\npi.registerCommand(\"stats\", {\n  description: \"Show session statistics\",\n  handler: async (args, ctx) => {\n    const count = ctx.sessionManager.getEntries().length;\n    ctx.ui.notify(`${count} entries`, \"info\");\n  }\n});\n[...]\nOptional: add argument auto-completion for `/command ...`:\n[...]\n```typescript\nimport type { AutocompleteItem } from \"@earendil-works/pi-tui\";\n[...]\npi.registerCommand(\"deploy\", {\n  description: \"Deploy to an environment\",\n  getArgumentCompletions: (prefix: string): AutocompleteItem[] | null => {\n    const envs = [\"dev\", \"staging\", \"prod\"];\n    const items = envs.map((e) => ({ value: e, label: e }));\n    const filtered = items.filter((i) => i.value.startsWith(prefix));\n    return filtered.length > 0 ? filtered : null;\n  },\n  handler: async (args, ctx) => {\n    ctx.ui.notify(`Deploying: ${args}`, \"info\");\n  },\n});","error":null},{"url":"https://github.com/sysid/pi-extensions/blob/main/HowTo.md","title":"HowTo.md at main · sysid/pi-extensions","content":"```typescript\nimport type { ExtensionAPI } from \"@mariozechner/pi-coding-agent\";\n\nexport default function (pi: ExtensionAPI) {\n    // Register event handlers, tools, commands, flags\n    pi.on(\"tool_call\", async (event, ctx) => {\n        // Intercept tool calls\n    });\n\n    pi.registerCommand(\"my-command\", {\n        description: \"Does something\",\n        handler: async (args, ctx) => {\n            ctx.ui.notify(\"Hello!\", \"info\");\n        },\n    });\n}\n```\n[...]\n| Method | Purpose |\n|--------|---------|\n| `pi.on(\"tool_call\", handler)` | Intercept tool calls before execution. Return `{ block: true, reason }` to block. |\n| `pi.on(\"session_start\", handler)` | Run setup when a session begins. |\n| `pi.on(\"session_shutdown\", handler)` | Run cleanup when a session ends. |\n| `pi.on(\"user_bash\", handler)` | Intercept user `!` bash commands. |\n| `pi.registerTool(tool)` | Register a custom tool (replaces built-in if same name). |\n| `pi.registerCommand(name, cmd)` | Register a `/command` available in the session. |\n| `pi.registerFlag(name, opts)` | Register a CLI flag (e.g. `--no-sandbox`). |\n| `pi.getFlag(name)` | Read a flag's value at runtime. |\n| `ctx.ui.notify(msg, level)` | Show a notification (`\"info\"`, `\"warning\"`, `\"error\"`). |\n| `ctx.ui.setStatus(key, text)` | Set a persistent status line entry. |\n[...]\n## Using Extensions\n[...]\n```bash\n# Load a single extension\npi -e ./packages/sandbox\n[...]\n# Load multiple extensions\npi -e ./packages/sandbox -e ./packages/vim-editor\n[...]\n# Pass flags to extensions\npi -e ./packages/sandbox --no-sandbox\n[...]\n# Install to ~/.pi for global availability\ncp -r packages/sandbox ~/.pi/agent/extensions/sandbox\ncd ~/.pi/agent/extensions/sandbox && npm install\npi -e ~/.pi/agent/extensions/sandbox\n```\n[...]\nexport default function (pi: ExtensionAPI) {\n    pi.on(\"session_start\", (_event, ctx) => {\n        ctx.ui.notify(\"My extension loaded!\", \"info\");\n    });\n}\n```\n[...]\n4. Run `npm install` at repo root (registers the new workspace).\n\n5. Test it: `pi -e ./packages/my-extension`","error":null},{"url":"https://instagit.com/badlogic/pi-mono/how-to-create-custom-extensions-for-pi-coding-agent/","title":"How to Create Custom Extensions for the Pi Coding Agent: A Complete Guide | pi-mono | Instagit","content":"You can create custom extensions for the Pi coding agent by writing a TypeScript or JavaScript module that exports a default factory function receiving an`ExtensionAPI` object, allowing you to register tools, commands, and lifecycle hooks.\n[...]\n- Registration methods –`on()`,`registerTool()`,`registerCommand()`,`registerShortcut()`,`registerFlag()`,`registerMessageRenderer()`\n- Flag access –`getFlag()` to read configuration values\n- Action methods –`sendMessage()`,`exec()`,`setLabel()`,`setModel()`, and UI helpers via`ctx.ui.*`\n[...]\nEvery extension must export a default factory function. Here is the minimal \"Hello World\" example from examples/extensions/hello.ts:\n[...]\n```\nimport type { ExtensionAPI } from \"@mariozechner/pi-coding-agent\";\n\nexport default function (pi: ExtensionAPI) {\n  // Run once when the agent starts\n  pi.on(\"agent_start\", async () => {\n    console.log(\"👋 Hello from my custom extension!\");\n  });\n\n  // Add a slash-command that the user can type\n  pi.registerCommand(\"greet\", {\n    description: \"Say hello from the extension\",\n    handler: async (_args, ctx) => {\n      ctx.ui.notify(\"Hello, world!\", \"info\");\n    },\n  });\n}\n\n```\n[...]\n### Adding Commands and Shortcuts\n[...]\nBeyond tools, you can register slash commands and keyboard shortcuts:\n[...]\n```\n// Register a slash command\npi.registerCommand(\"deploy\", {\n  description: \"Deploy the current project\",\n  handler: async (args, ctx) => {\n    await ctx.exec(\"npm\", [\"run\", \"deploy\"]);\n    ctx.ui.notify(\"Deployment complete\", \"success\");\n  },\n});\n[...]\n// Register a keyboard shortcut (Ctrl+Shift+T)\npi.registerShortcut(\"ctrl+shift+t\", async (ctx) => {\n  await ctx.sendMessage(\"Trigger custom workflow\");\n});\n\n```","error":null},{"url":"https://github.com/badlogic/pi-mono/blob/main/packages/coding-agent/docs/extensions.md","title":"packages/coding-agent/docs/extensions.md at main · earendil-works/pi","content":"- **Custom tools** - Register tools the LLM can call via `pi.registerTool()`\n- **Event interception** - Block or modify tool calls, inject context, customize compaction\n- **User interaction** - Prompt users via `ctx.ui` (select, confirm, input, notify)\n- **Custom UI components** - Full TUI components with keyboard input via `ctx.ui.custom()` for complex interactions\n- **Custom commands** - Register commands like `/mycommand` via `pi.registerCommand()`\n- **Session persistence** - Store state that survives restarts via `pi.appendEntry()`\n- **Custom rendering** - Control how tool calls/results and messages appear in TUI\n[...]\nexport default function (\n[...]\n: ExtensionAPI) {\n  // React to events\n  pi.on(\"session_start\", async (_event, ctx) => {\n    ctx.ui.notify(\"Extension loaded!\", \"info\");\n  });\n\n  pi.on(\"tool_call\", async (event, ctx) => {\n    if (event.toolName === \"bash\" && event.input.command?.includes(\"rm -rf\")) {\n      const ok = await ctx.ui.confirm(\"Dangerous!\", \"Allow rm -rf?\");\n      if (!ok) return { block: true, reason: \"Blocked by user\" };\n    }\n  });\n\n  // Register a custom tool\n  pi.registerTool({\n    name: \"greet\",\n    label: \"Greet\",\n    description: \"Greet someone by name\",\n    parameters: Type.Object({\n      name: Type.String({ description: \"Name to greet\" }),\n    }),\n    async execute(toolCallId, params, signal, onUpdate, ctx) {\n      return {\n        content: [{ type: \"text\", text: `Hello, ${params.name}!` }],\n        details: {},\n      };\n    },\n  });\n\n  // Register a command\n  pi.registerCommand(\"hello\", {\n    description: \"Say hello\",\n    handler: async (args, ctx) => {\n      ctx.ui.notify(`Hello ${args || \"world\"}!`, \"info\");\n    },\n  });\n}\n[...]\nFor distributed pi packages installed with `pi install` (npm or git), runtime deps must be in `dependencies`. Package installation uses production installs (`npm install --omit=dev`) by default, so `devDependencies` are not available at runtime; when `npmCommand` is configured, git packages use plain `install` for compatibility with wrappers.\n[...]\nexport default function (pi: ExtensionAPI) {\n  // Subscribe to events\n  pi.on(\"event_name\", async (event, ctx) => {\n    // ctx.ui for user interaction\n    const ok = await ctx.ui.confirm(\"Title\", \"Are you sure?\");\n    ctx.ui.notify(\"Done!\", \"success\");\n    ctx.ui.setStatus(\"my-ext\", \"Processing...\");  // Footer status\n    ctx.ui.setWidget(\"my-ext\", [\"Line 1\", \"Line 2\"]);  // Widget above editor (default)\n  });\n\n  // Register tools, commands, shortcuts, flags\n  pi.registerTool({ ... });\n  pi.registerCommand(\"name\", { ... });\n  pi.registerShortcut(\"ctrl+x\", { ... });\n  pi.registerFlag(\"my-flag\", { ... });\n}\n[...]\nnpm install` in the extension directory, then\n[...]\n_modules/` work\n[...]\n```typescript\npi.registerCommand(\"my-cmd\", {\n[...]\n: async (args, ctx\n[...]\nawait ctx.waitForIdle();\n    // Agent is now idle, safe to modify session\n  },\n});\n[...]\n### pi.registerCommand(name, options)\n[...]\nIf multiple extensions register the same command name, pi keeps them all and assigns numeric invocation suffixes in load order, for example `/review:1` and `/review:2`.\n[...]\n```typescript\npi.registerCommand(\"stats\", {\n  description: \"Show session statistics\",\n  handler: async (args, ctx) => {\n    const count = ctx.sessionManager.getEntries().length;\n    ctx.ui.notify(`${count} entries`, \"info\");\n  }\n});\n[...]\nOptional: add argument auto-completion for `/command ...`:\n[...]\n```typescript\nimport type { AutocompleteItem } from \"@earendil-works/pi-tui\";\n[...]\npi.registerCommand(\"deploy\", {\n  description: \"Deploy to an environment\",\n  getArgumentCompletions: (prefix: string): AutocompleteItem[] | null => {\n    const envs = [\"dev\", \"staging\", \"prod\"];\n    const items = envs.map((e) => ({ value: e, label: e }));\n    const filtered = items.filter((i) => i.value.startsWith(prefix));\n    return filtered.length > 0 ? filtered : null;\n  },\n  handler: async (args, ctx) => {\n    ctx.ui.notify(`Deploying: ${args}`, \"info\");\n  },\n});","error":null},{"url":"https://registry.npmjs.org/pi-must-have-extension","title":"pi-must-have-extension","content":"### Local Extension Folder\n[...]\nCopy this repository to one of the following locations:\n[...]\n```text\n~/.pi/agent/extensions/pi-must-have-extension     # Global default (when PI_CODING_AGENT_DIR is unset)\n.pi/extensions/pi-must-have-extension             # Project-specific\n```\n[...]\nPi will auto-discover the extension on startup.\n[...]\n### NPM Package\n[...]\n```bash\npi install npm:pi-must-have-extension\n```\n[...]\nautomatically. When\n[...]\ntype prompts containing\n[...]\nThe extension does not transform:\n[...]\n- Slash commands (e.g., `/help`, `/reload`)\n- Shell commands (e.g., `!ls`, `!git status`)\n- Empty input\n[...]\n```bash\nnpm install          # Install dependencies\nnpm run build        # Type-check with TypeScript\nnpm run test         # Run test suite\nnpm run check        # Build + test\n```","error":null},{"url":"https://github.com/nicobailon/pi-prompt-template-model","title":"nicobailon/pi-prompt-template-model","content":"# Repository: nicobailon/pi-prompt-template-model\n[...]\nPi extension: Add model frontmatter to prompt templates for automatic model switching\n[...]\nAdds `model`, `skill`, and `thinking` frontmatter to pi prompt templates. Define slash commands that switch to the right model, set a thinking level, inject skill context, and auto-restore your session when done.\n[...]\n```bash\npi install npm:pi-prompt-template-model\n```\n[...]\nAdd `model` and optionally `skill` to any prompt template:\n[...]\n## Frontmatter Reference\n[...]\nAll fields are optional. Templates that don't use any extension features (no `model`, `skill`, `thinking`, etc.) are left to pi's default prompt loader.\n[...]\n| Field | Default | What it does |\n| --- | --- | --- |\n| `model` | current session model | Which model to use. Accepts a single model, a `provider/model-id` pair, or a comma-separated fallback list (see Model Format). Ignored when `chain` is set. |\n| `skill` | — | Injects a skill's content as a context message before the agent handles your task. No extra round-trip — the agent gets the expertise immediately. See Skill Resolution. |\n| `thinking` | — | Thinking level for the model: `off`, `minimal`, `low`, `medium`, `high`, or `xhigh`. |\n| `description` | — | Short text shown next to the command in autocomplete. |\n| `chain` | — | Declares a reusable pipeline of templates (`step -> step`). When set, the body is ignored. See Chain Templates. |\n| `chainContext` | — | Chain templates only. Set to `summary` so delegated steps receive a compact summary of what previous steps did. Steps with `inheritContext: true` are excluded. See Chain context for delegated steps. |\n[...]\n| Field | Default | What it does |\n| --- | --- | --- |\n| `restore` | `true` | After the command finishes, switch back to whatever model and thinking level were active before. Set `false` to stay on the new model. |\n| `loop` | — | Run this template multiple times by default (1–999, `true`, or `unlimited`). CLI `--loop` overrides this. See Loop Execution. |\n| `rotate` | `false` | When `true` and looping, cycle through models in the `model` list instead of using fallback semantics. Thinking levels can also be comma-separated to pair with each model. |\n| `fresh` | `false` | When looping, collapse the conversation between iterations to a brief summary instead of carrying the full context forward. Saves tokens on long loops. |\n[...]\n| `converge` | `true` | When looping, stop early if an iteration makes no file changes. Set `false` to always run every iteration. |\n[...]\n| `worktree` |\n[...]\nfalse` |\n[...]\nwork runs in separate\n[...]\nworktrees.\n[...]\n`parallel()` steps,\n[...]\n`parallel:\n[...]\nvia `best\n[...]\nworktree`. |\n[...]\n| Field | Default | What it does |\n| --- | --- | --- |\n| `subagent` | — | Delegate execution to a subagent instead of running in the current session. `true` uses the default `delegate` agent; a string value like `reviewer` targets that specific agent. Requires pi-subagents. |\n| `inheritContext` | `false` | Only meaningful with `subagent`. When `true`, the subagent receives a fork of the current conversation context instead of starting fresh. |\n[...]\n| `parallel` | — |\n[...]\nated prompts only. Repeats\n[...]\nEach copy gets\n[...]\n2. |\n[...]\n| `bestOfN` | — | Compare\n[...]\n## Model Format\n[...]\n## Inline Model\n[...]\n## Argument Substitution\n[...]\nPrompt bodies support placeholders that expand to the arguments passed after the command name:\n[...]\n| Placeholder | Expands to |\n| --- | --- |\n| `$1`, `$2`, ... | The Nth argument (1-indexed) |\n| `$@` or `@$` or `$ARGUMENTS` | All arguments joined with spaces |\n| `${@:N}` | All arguments from position N onward |\n| `${@:N:L}` | L arguments starting from position N |\n[...]\n-202\n[...]\n`/analyze src/main.ts performance edge cases error handling` expands `$1` to `src/main.ts`, `$2` to `performance`, and `${@:3}` to `edge cases error handling`.","error":null},{"url":"https://github.com/badlogic/pi-mono/pull/2780","title":"feat(coding-agent,tui): support argument-hint frontmatter in prompt templates · Pull Request #2780 · badlogic/pi-mono","content":"## feat(coding-agent,tui): support argument-hint frontmatter in prompt templates\n[...]\nParse `argument-hint` from prompt template frontmatter and display it in the autocomplete dropdown, so users can see what arguments a command expects before invoking it.\n[...]\n## Frontmatter format\n[...]\nUse ` ` for required arguments and `[square brackets]` for optional ones:\n[...]\n```yaml\n---\ndescription: Review PRs from URLs with structured issue and code analysis\nargument-hint: \"<PR-URL>\"\n---\n```\n[...]\nThe hint prepends to the description column in autocomplete:\n[...]\n```\n→ pr   <PR-URL>       — Review PRs from URLs with structured issue and code analysis\n  is   <issue>        — Analyze GitHub issues (bugs or feature requests)\n  wr   [instructions] — Finish the current task end-to-end with changelog, commit, and push\n  cl   — Audit changelog entries before release\n```\n[...]\n| File | Change |\n| --- | --- |\n| `packages/coding-agent/src/core/prompt-templates.ts` | Add `argumentHint?` to `PromptTemplate`, parse `argument-hint` from frontmatter |\n| `packages/coding-agent/src/modes/interactive/interactive-mode.ts` | Pass `argumentHint` through to `SlashCommand` |\n| `packages/tui/src/autocomplete.ts` | Add `argumentHint?` to `SlashCommand`, prepend hint to description in dropdown |\n| `packages/coding-agent/test/prompt-templates.test.ts` | Tests for parsing required/optional hints, missing hints, empty hints, special characters |\n| `packages/coding-agent/docs/prompt-templates.md` | Document `argument-hint` frontmatter field with convention and examples |\n| `.pi/prompts/pr.md`, `is.md`, `wr.md` | Add `argument-hint` to built-in project templates |","error":null},{"url":"https://github.com/badlogic/pi-mono/issues/2761","title":"Support argument-hint frontmatter in prompt templates · Issue #2761 · badlogic/pi-mono","content":"## Support argument-hint frontmatter in prompt templates\n[...]\n## Feature: Support `argument-hint` frontmatter in prompt templates\n[...]\nParse `argument-hint` from prompt template frontmatter and display it as dim text in the autocomplete dropdown, matching Claude Code's behavior for custom commands.\n[...]\nWhen teams define custom slash commands (e.g., `/review`, `/ship`, `/ticket`), users have no way to discover what arguments the command accepts without reading the source file. Claude Code solves this with `argument-hint` frontmatter that renders in the typeahead:\n[...]\nPi already parses `description` from frontmatter and shows it in autocomplete. This extends that pattern to argument hints.\n[...]\n**`packages/coding-agent`** (parsing):\n\n- `src/core/prompt-templates.ts` — add `argumentHint` to `PromptTemplate` interface, parse `argument-hint` from frontmatter in `loadTemplateFromFile`\n- `src/modes/interactive/interactive-mode.ts` — pass `argumentHint` through when building `templateCommands`\n[...]\n**`packages/tui`** (rendering):\n[...]\n- `src/autocomplete.ts` — add `argumentHint` to `SlashCommand` interface\n- `src/components/select-list.ts` — append dim `argumentHint` to the label when rendering slash command items\n[...]\n### Frontmatter format\n[...]\n```yaml\n---\ndescription: Code review — local or posted to a PR\nargument-hint: [file | #PR | PR-URL]\n---\n```\n[...]\nThis aligns with Claude Code's existing `argument-hint` frontmatter key, so templates work in both tools.\n[...]\nin PR #27\n[...]\n0: feat(coding-\n[...]\n): support argument-hint frontmatter in prompt templates ·\n[...]\n026","error":null},{"url":"https://lazypi.org/docs/packages/prompt-templates.html","title":"Prompt Templates — LazyPi Docs","content":"Add model, skill, and thinking frontmatter to Pi prompt templates so slash commands switch modes automatically.\n[...]\nPi-prompt-template-model extends Pi's built-in prompt templates with frontmatter like`model`,`skill`, and`thinking`. That lets a template become a reusable agent mode: run a single slash command and Pi can switch to the right model, preload a skill, adjust thinking depth, and restore your previous session settings when the task finishes.\n[...]\nThe extension also supports more advanced template workflows like fallback model lists, chain templates, looping, and optional delegated execution through sub-agents. You still author normal prompt templates — this package just makes them much more powerful.\n[...]\nOne of the easiest ways to make Pi feel personal is to create task-specific slash commands. Prompt Templates turns those commands into reliable workflows instead of fragile text snippets. You can make a`/deep-debug` template that always uses a stronger model, a`/quick-fix` template that stays cheap and fast, or a review template that injects exactly the right skill every time.\n[...]\nAfter installation, restart Pi so the extension loads. Then add frontmatter to one of your prompt templates:\n[...]\n```\n---\ndescription: Debug Python in tmux REPL\nmodel: claude-sonnet-4-20250514\nskill: tmux\nthinking: medium\n---\nStart a Python REPL session and help me debug: $@\n```\n[...]\nWhen you run that template's slash command, Pi switches to the requested model, loads the skill context, and applies the chosen thinking level for the duration of the task. By default it restores your previous session settings when the command completes.\n[...]\nIf you use delegated execution features like`subagent` or`inheritContext`, LazyPi already installs Sub-agents for you — so those workflows are available out of the box.\n[...]\n→ GitHub — nicobailon/pi-prompt-template-model","error":null},{"url":"https://registry.npmjs.org/pi-prompt-template-model","title":"pi-prompt-template-model","content":"# pi-prompt-template-model\n[...]\nPrompt template model selector extension for pi coding agent\n[...]\nnpm i pi-prompt-template-model\n[...]\nAdds `model`, `skill`, and `thinking` frontmatter to pi prompt templates. Define slash commands that switch to the right model, set a thinking level, inject skill context, and auto-restore your session when done.\n[...]\npi install npm:pi-prompt-template-model\n[...]\nAdd `model` and optionally `skill` to any prompt template:\n[...]\n## Frontmatter Reference\n[...]\nAll fields are optional. Templates that don't use any extension features (no `model`, `skill`, `thinking`, etc.) are left to pi's default prompt loader.\n[...]\n| Field | Default | What it does |\n| --- | --- | --- |\n| `model` | current session model | Which model to use. Accepts a single model, a `provider/model-id` pair, or a comma-separated fallback list (see Model Format). Ignored when `chain` is set. |\n| `skill` | — | Injects a skill's content as a context message before the agent handles your task. No extra round-trip — the agent gets the expertise immediately. See Skill Resolution. |\n| `thinking` | — | Thinking level for the model: `off`, `minimal`, `low`, `medium`, `high`, or `xhigh`. |\n| `description` | — | Short text shown next to the command in autocomplete. |\n| `chain` | — | Declares a reusable pipeline of templates (`step -> step`). When set, the body is ignored. See Chain Templates. |\n| `chainContext` | — | Chain templates only. Set to `summary` so delegated steps receive a compact summary of what previous steps did. Steps with `inheritContext: true` are excluded. See Chain context for delegated steps. |\n[...]\n| Field | Default | What it does |\n| --- | --- | --- |\n| `restore` | `true` | After the command finishes, switch back to whatever model and thinking level were active before. Set `false` to stay on the new model. |\n| `loop` | — | Run this template multiple times by default (1–999, `true`, or `unlimited`). CLI `--loop` overrides this. See Loop Execution. |\n| `rotate` | `false` | When `true` and looping, cycle through models in the `model` list instead of using fallback semantics. Thinking levels can also be comma-separated to pair with each model. |\n| `fresh` | `false` | When looping, collapse the conversation between iterations to a brief summary instead of carrying the full context forward. Saves tokens on long loops. |\n[...]\n| `converge` | `true` | When looping, stop early if an iteration makes no file changes. Set `\n[...]\n` to always run every iteration. |\n[...]\ntree`. |\n[...]\n| Field | Default | What it does |\n| --- | --- | --- |\n| `subagent` | — | Delegate execution to a subagent instead of running in the current session. `true` uses the default `delegate` agent; a string value like `reviewer` targets that specific agent. Requires pi-subagents. |\n| `inheritContext` | `false` | Only meaningful with `subagent`. When `true`, the subagent receives a fork of the current conversation context instead of starting fresh. |\n| `parallel` | — | Delegated prompts only. Repeats\n[...]\nin parallel `N` times. Each copy gets\n[...]\n2/3\n[...]\ntask. Must be an\n[...]\ngreater than or equal to\n[...]\n2. |\n[...]\n| `bestOfN` | — | Compare templates only. Nested compare authoring\n[...]\n## Model Format\n[...]\nes all of that\n[...]\n## Argument Substitution\n[...]\nPrompt bodies support placeholders that expand to the arguments passed after the command name:\n[...]\n| Placeholder | Expands to |\n| --- | --- |\n| `$1`, `$2`, ... | The Nth argument (1-indexed) |\n| `$@` or `@$` or `$ARGUMENTS` | All arguments joined with spaces |\n| `${@:N}` | All arguments from position N onward |\n| `${@:N:L}` | L arguments starting from position N |\n[...]\n```markdown\n[...]\nmodel:\n[...]\n-sonnet-\n[...]\n-20250\n[...]\n`/analyze src/main.ts performance edge cases error handling` expands `$1` to `src/main.ts`, `$2` to `performance`, and `${@:3}` to `edge cases error handling`.","error":null},{"url":"https://github.com/nicobailon/pi-prompt-template-model/releases","title":"Releases · nicobailon/pi-prompt-template-model · GitHub","content":"Releases · nicobailon/pi-prompt-template-model · GitHub\n[...]\n/ pi-prompt-template-model Public\n[...]\nv0.7.0\n[...]\n- Added a first-class`bestOfN:` prompt-template authoring surface for compare workflows, with configurable`workers`,`reviewers`, optional`finalApplier`, and nested`bestOfN.worktree` support.\n- Added configurable compare runtime overrides via`--workers`,`--reviewers`,`--workers-append`,`--reviewers-append`, and`--final-applier`.\n- Added`count: N` compare-slot shorthand so one worker or reviewer slot can fan out into repeated identical runs without manual duplication.\n- Added a shipped`/best-of-n` example prompt that demonstrates mixed worker counts, mixed reviewer counts, thinking-level model suffixes,`taskSuffix`, and final real-branch application.\n[...]\n- Compare prompts now run as worker fan-out, reviewer fan-in, then an optional final apply step that edits the real branch instead of stopping at recommendation prose.\n- Reviewer defaults now stay findings-only, while`finalApplier` handles winner-picking or synthesis plus best-effort verification on the current branch.\n- Legacy top-level compare frontmatter in templates (`workers`,`reviewers`,`finalApplier`, top-level compare`worktree`) is now rejected in favor of`bestOfN:`.\n[...]\n- Delegated parallel live rendering now shows richer per-task output, including task index, model, recent tools, and bounded rolling output lines.\n[...]\n- README and bundled examples were refreshed to match the shipped compare/runtime surface, including`bestOfN`, compare-wide vs slot-level`cwd`, and chain`parallel(...)``cwd` rules under`worktree: true`.\n[...]\n- Compare execution now allows partial success by phase: worker and reviewer phases continue as long as at least one slot succeeds, and`finalApplier` can still fall back to worker-only evidence when every reviewer fails.\n[...]\n- Preserved successful worker`=== Worktree Changes ===` summaries when building reviewer and final-apply inputs, so downstream compare stages do not lose worktree evidence.\n[...]\n- Invalid`bestOfN` blocks and legacy compare templates no longer degrade into ordinary runnable prompts after diagnostics; they are skipped entirely.\n[...]\n- `finalApplier` validation now correctly rejects unsupported`cwd` and`count` fields in both frontmatter and runtime overrides.\n[...]\n- Corrected remaining docs/tooling drift, including the`run-prompt` unlimited-loop cap text and compare/chain`cwd` wording.\n[...]\n- `--model=provider/model-id` runtime flag to override a template's model for a single invocation\n- `--fork` runtime flag to enable forked context at invocation time (implies`--subagent`)\n- Inline loop iterations include a`[Loop 2/5]` prefix so the agent knows it's in a loop\n- `loop: unlimited`(and`loop: true`) frontmatter for open-ended loops\n- Model rotation via`rotate: true` frontmatter — cycles through models each iteration\n[...]\n- Escape during a loop or chain now stops the loop instead of continuing\n[...]\n- Delegation errors during loops no longer abort the\n[...]\n- Bare`--loop` in chain steps now correctly runs unlimited iterations\n[...]\n- Unlimited loop safety cap raised from 50 to 999; convergence follows the`converge` field\n[...]\n- Chain step progress now shows in the status bar (e.g.,`step 2/3: simplify`) and persists until the chain completes.\n- Added`parallel(...)` chain step support for delegated prompt templates, including parser/frontmatter validation, delegated task fan-out, aggregated result rendering, and per-task progress display.","error":null},{"url":"https://github.com/nicobailon/pi-prompt-template-model/blob/main/prompt-execution.ts","title":"prompt-execution.ts at main · nicobailon/pi-prompt-template-model","content":"# File: nicobailon/pi-prompt-template-model/prompt-execution.ts\n[...]\n- Repository: nicobailon/pi-prompt-template-model | Pi extension: Add model frontmatter to prompt templates for automatic model switching | 151 stars | TypeScript\n- Branch: main\n[...]\n```ts\nimport type { Model } from \"@mariozechner/pi-ai\";\nimport { substituteArgs } from \"./args.js\";\nimport { getResolvedModelRef, selectModelCandidate, type RegistryLike, type SelectedModelCandidate } from \"./model-selection.js\";\nimport type { PromptWithModel } from \"./prompt-loader.js\";\nimport { renderTemplateConditionals } from \"./template-conditionals.js\";\n[...]\nexport function renderPromptForResolvedModel(\n\tprompt: Pick<PromptWithModel, \"name\" | \"content\">,\n\targs: string[],\n\tmodel: Model<any>,\n): RenderedPrompt {\n\tconst rendered = renderTemplateConditionals(prompt.content, getResolvedModelRef(model), prompt.name);\n\tconst content = substituteArgs(rendered.content, args);\n\tif (content.trim().length === 0) {\n\t\treturn {\n\t\t\tempty: `Prompt \\`${prompt.name}\\` rendered to an empty message.`,\n\t\t\twarning: rendered.error,\n\t\t};\n\t}\n\treturn {\n\t\tcontent,\n\t\twarning: rendered.error,\n\t};\n}\n[...]\nexport async function preparePromptExecution(\n\tprompt: Pick<PromptWithModel, \"name\" | \"content\" | \"models\">,\n\targs: string[],\n\tcurrentModel: Model<any> | undefined,\n\tmodelRegistry: RegistryLike,\n\toptions?: PromptExecutionOptions,\n): Promise<PreparedPromptExecution | EmptyPromptAbort | undefined> {\n\tconst selectedModel =\n\t\tprompt.models.length === 0\n\t\t\t? (() => {\n\t\t\t\tconst hasInheritedModel = options !== undefined && Object.hasOwn(options, \"inheritedModel\");\n\t\t\t\tconst inheritedModel = hasInheritedModel ? options.inheritedModel : currentModel;\n\t\t\t\tif (!inheritedModel) {\n\t\t\t\t\treturn {\n\t\t\t\t\t\tmessage: `Prompt \\`${prompt.name}\\` has no \\`model\\` configured and there is no active session model to inherit.`,\n\t\t\t\t\t};\n\t\t\t\t}\n\t\t\t\treturn {\n\t\t\t\t\tmodel: inheritedModel,\n\t\t\t\t\talreadyActive: sameModel(currentModel, inheritedModel),\n\t\t\t\t};\n\t\t\t})()\n\t\t\t: await selectModelCandidate(prompt.models, currentModel, modelRegistry);\n\tif (!selectedModel) return undefined;\n\tif (\"message\" in selectedModel) return selectedModel;\n\n\tconst rendered = renderPromptForResolvedModel(prompt, args, selectedModel.model);\n\tif (rendered.empty) {\n\t\treturn {\n\t\t\tmessage: rendered.empty,\n\t\t\twarning: rendered.warning,\n\t\t};\n\t}\n\n\treturn {\n\t\tselectedModel,\n\t\tcontent: rendered.content ?? \"\",\n\t\twarning: rendered.warning,\n\t};\n}","error":null},{"url":"https://deepwiki.com/badlogic/pi-mono/4.8-skills-and-prompt-templates","title":"Skills & Prompt Templates | badlogic/pi-mono | DeepWiki","content":"Relevant source files\n[...]\n* .pi/prompts/is.md\n* .pi/prompts/pr.md\n* .pi/prompts/wr.md\n* packages/coding-agent/docs/prompt-templates.md\n* packages/coding-agent/docs/skills.md\n* packages/coding-agent/src/core/package-manager.ts\n* packages/coding-agent/src/core/prompt-templates.ts\n* packages/coding-agent/src/core/resource-loader.ts\n* packages/coding-agent/src/core/skills.ts\n* packages/coding-agent/src/utils/paths.ts\n[...]\n* packages/coding-\n[...]\n/test/fixtures/skills/root-skill-preferred/SKILL.md\n[...]\n* packages/\n[...]\nThis page documents the Skills and Prompt Templates systems in `pi-coding-agent`. Skills are on-demand capability packages following the Agent Skills standard, while Prompt Templates are reusable Markdown prompts with variable substitution. Both systems rely on the `ResourceLoader` and `PackageManager` for discovery and lifecycle management.\n[...]\n## Prompt Templates\n[...]\nPrompt Templates are reusable Markdown files loaded from disk that allow for dynamic argument substitution packages/coding-agent/src/core/prompt-templates.ts11-18\n[...]\n### Variable Substitution\n[...]\nThe `substituteArgs` function handles bash-style placeholders within the template content packages/coding-agent/src/core/prompt-templates.ts68-102\n[...]\n|Syntax|Description|\n|`$1, $2, ...`|Positional arguments (1-indexed) packages/coding-agent/src/core/prompt-templates.ts73-76|\n|`$@` / `$ARGUMENTS`|All arguments joined by a single space packages/coding-agent/src/core/prompt-templates.ts96-99|\n|`${@:N}`|Arguments from index `N` to the end (bash-style slicing) packages/coding-agent/src/core/prompt-templates.ts80-90|\n|`${@:N:L}`|`L` arguments starting from index `N`packages/coding-agent/src/core/prompt-templates.ts80-88|\n[...]\n**Sources:** packages/coding-agent/src/core/prompt-templates.ts24-102\n[...]\n### Discovery & Precedence\n[...]\nTemplates are loaded from `.md` files in global and project directories packages/coding-agent/src/core/prompt-templates.ts207-212\n[...]\n* **Global:** `\\~/.pi/agent/prompts/` packages/coding-agent/src/core/prompt-templates.ts215\n* **Project:** `.pi/prompts/` packages/coding-agent/src/core/prompt-templates.ts216\n* **Resolution:** The `loadPromptTemplates` function aggregates templates from all sources, including explicit `promptPaths` provided via CLI or settings packages/coding-agent/src/core/prompt-templates.ts177-186\n[...]\n**Sources:** packages/coding-agent/src/core/prompt-templates.ts177-216\n[...]\nprovides accessors for the agent session packages/coding-agent/\n[...]\n/core/resource-loader\n[...]\n* **`substituteArgs`**: Performs string replacement in prompt templates. It ensures that positional arguments are replaced before wildcards to prevent recursive substitution issues packages/coding-agent/src/core/prompt-templates.ts68-102","error":null},{"url":"https://github.com/earendil-works/pi/blob/main/packages/coding-agent/docs/packages.md","title":"packages/coding-agent/docs/packages.md at main · earendil-works/pi","content":"By default, `install` and `remove` write to global settings (`~/.pi/agent/settings.json`). Use `-l` to write to project settings (`.pi/settings.json`) instead. Project settings can be shared with your team, and pi installs any missing packages automatically on startup.\n[...]\nUse `pi config` to enable or disable extensions, skills, prompt templates, and themes from installed packages and local directories. Works for both global (`~/.pi/agent`) and project (`.pi/`) scopes.\n[...]\nPackages can appear in both global and project settings. If the same package appears in both, the project entry wins. Identity is determined by:\n[...]\n- npm: package name\n- git: repository URL without ref\n- local: resolved absolute path","error":null},{"url":"https://github.com/earendil-works/pi/blob/main/packages/coding-agent/docs/settings.md","title":"packages/coding-agent/docs/settings.md at main · earendil-works/pi","content":"Pi uses JSON settings files with project settings overriding global settings.\n[...]\n| Location | Scope |\n|----------|-------|\n| `~/.pi/agent/settings.json` | Global (all projects) |\n| `.pi/settings.json` | Project (current directory) |\n[...]\nEdit directly or use `/settings` for common options.\n[...]\n| Setting | Type | Default | Description |\n|---------|------|---------|-------------|\n| `shellPath` | string | - | Custom shell path (e.g., for Cygwin on Windows) |\n| `shellCommandPrefix` | string | - | Prefix for every bash command (e.g., `\"shopt -s expand_aliases\"`) |\n| `npmCommand` | string[] | - | Command argv used for npm package lookup/install operations (e.g., `[\"mise\", \"exec\", \"node@20\", \"--\", \"npm\"]`) |\n[...]\n`npmCommand` is used for all npm package-manager operations, including installs, uninstalls, and dependency installs inside git packages. Use argv-style entries exactly as the process should be launched. When `npmCommand` is configured, git package dependency installs use plain `install` to avoid npm-specific flags in wrappers or alternate package managers.\n[...]\nThese settings define where to load extensions, skills, prompts, and themes from.\n[...]\nPaths in `~/.pi/agent/settings.json` resolve relative to `~/.pi/agent`. Paths in `.pi/settings.json` resolve relative to `.pi`. Absolute paths and `~` are supported.\n[...]\n| Setting | Type | Default | Description |\n|---------|------|---------|-------------|\n| `packages` | array | `[]` | npm/git packages to load resources from |\n| `extensions` | string[] | `[]` | Local extension file paths or directories |\n| `skills` | string[] | `[]` | Local skill file paths or directories |\n| `prompts` | string[] | `[]` | Local prompt template paths or directories |\n| `themes` | string[] | `[]` | Local theme file paths or directories |\n| `enableSkillCommands` | boolean | `true` | Register skills as `/skill:name` commands |\n[...]\nString form loads all resources from a package:\n[...]\n```json\n{\n  \"packages\": [\"pi-skills\", \"@org/my-extension\"]\n}\n[...]\nto load:\n[...]\n```json\n{\n  \"packages\": [\n    {\n      \"source\": \"\n[...]\n-skills\",\n      \"skills\": [\"brave-search\", \"transcribe\"],\n      \"extensions\": []\n    }\n  ]\n}\n[...]\n## Project Overrides\n[...]\nProject settings (`.pi/settings.json`) override global settings. Nested objects are merged:\n[...]\n```json\n// ~/.pi/agent/settings.json (global)\n{\n  \"theme\": \"dark\",\n  \"compaction\": { \"enabled\": true, \"reserveTokens\": 16384 }\n}\n\n// .pi/settings.json (project)\n{\n  \"compaction\": { \"reserveTokens\": 8192 }\n}\n\n// Result\n{\n  \"theme\": \"dark\",\n  \"compaction\": { \"enabled\": true, \"reserveTokens\": 8192 }\n}\n```","error":null},{"url":"https://github.com/badlogic/pi-mono/blob/main/packages/coding-agent/docs/usage.md","title":"packages/coding-agent/docs/usage.md at main · earendil-works/pi","content":"### Package Commands\n[...]\n```bash\npi install <source> [-l]     # Install package, -l for project-local\npi remove <source> [-l]      # Remove package\npi uninstall <source> [-l]   # Alias for remove\npi update [source|self|pi]   # Update pi and packages; skips pinned packages\npi update --extensions       # Update packages only\npi update --self             # Update pi only\npi update --extension <src>  # Update one package\npi list                      # List installed packages\npi config                    # Enable/disable package resources\n```\n[...]\n| Variable | Description |\n|----------|-------------|\n| `PI_CODING_AGENT_DIR` | Override config directory; default is `~/.pi/agent` |\n| `PI_CODING_AGENT_SESSION_DIR` | Override session storage directory; overridden by `--session-dir` |\n| `PI_PACKAGE_DIR` | Override package directory, useful for Nix/Guix store paths |\n| `PI_OFFLINE` | Disable startup network operations, including update checks, package update checks, and install/update telemetry |\n| `PI_SKIP_VERSION_CHECK` | Skip the Pi version update check at startup. This prevents the `pi.dev` latest-version request |\n| `PI_TELEMETRY` | Override install/update telemetry: `1`/`true`/`yes` or `0`/`false`/`no`. This does not disable update checks |\n| `PI_CACHE_RETENTION` | Set to `long` for extended prompt cache where supported |\n| `VISUAL`, `EDITOR` | External editor for Ctrl+G |","error":null},{"url":"https://github.com/badlogic/pi-mono/blob/refs/heads/main/packages/coding-agent/README.md","title":"heads/main/packages/coding-agent/README.md at refs · badlogic/pi-mono","content":"| Location | Scope |\n|----------|-------|\n[...]\n| `~/.\n[...]\n/agent/settings\n[...]\n### Pi Packages\n[...]\n```bash\npi install npm:@foo/pi-tools\npi install npm:@foo/pi-tools@1.2.3      # pinned version\n[...]\npi update                               #\n[...]\npi update --extensions\n[...]\npi config                               # enable/\n[...]\nextensions, skills, prompts, themes\n[...]\nPackages install to `~/.pi/agent/git/` (git) or global npm. Use `-l` for project-local installs (`.pi/git/`, `.pi/npm/`). Git packages install dependencies with `npm install --omit=dev` by default, so runtime deps must be listed under `dependencies`; when `npmCommand` is configured, git packages use plain `install` for compatibility with wrappers. If you use a Node version manager and want package installs to reuse a stable npm context, set `npmCommand` in `settings.json`, for example `[\"mise\", \"exec\", \"node@20\", \"--\", \"npm\"]`.\n[...]\nWithout a `pi` manifest, pi auto-discovers from conventional directories (`extensions/`, `skills/`, `prompts/`, `themes/`).\n[...]\n```bash\npi install <source> [-l]     # Install package, -l for project-local\npi remove <source> [-l]      # Remove package\npi uninstall <source> [-l]   # Alias for remove\npi update [source|self|pi]   # Update pi and packages (skips pinned packages)\npi update --extensions       # Update packages only\npi update --self             # Update pi only\npi update --self --force     # Reinstall pi even if current\npi update --extension <src>  # Update one package\npi list                      # List installed packages\npi config                    # Enable/disable package resources","error":null},{"url":"https://github.com/earendil-works/pi/blob/main/packages/coding-agent/docs/quickstart.md","title":"packages/coding-agent/docs/quickstart.md at main · earendil-works/pi","content":"Pi is distributed as an npm package:\n[...]\n```bash\nnpm install -g @earendil-works/pi-coding-agent\n```\n[...]\nThen start pi in the project directory you want it to work on:\n[...]\n```bash\ncd /path/to/project\npi\n```\n[...]\n## Give pi project instructions\n[...]\nPi loads context files at startup. Add an `AGENTS.md` file to tell it how to work in a project:\n[...]\n```markdown\n# Project Instructions\n\n- Run `npm run check` after code changes.\n- Do not run production migrations locally.\n- Keep responses concise.\n[...]\nPi loads:\n\n- `~/.pi/agent/AGENTS.md` for global instructions\n- `AGENTS.md` or `CLAUDE.md` from parent directories and the current directory\n[...]\nRestart pi, or run `/reload`, after changing context files.\n[...]\n- Using Pi - interactive mode, slash commands, sessions, context files, and CLI reference.\n- Providers - authentication and model setup.\n- Settings - global and project configuration.\n- Keybindings - shortcuts and customization.\n- Pi Packages - install shared extensions, skills, prompts, and themes.","error":null},{"url":"https://pi.dev/","title":"Pi Coding Agent","content":"Pi is a minimal terminal coding harness. Adapt Pi to your workflows, not the other way around. Customize Pi with extensions, skills, prompt templates, and themes. Bundle them as Pi packages and share via npm or git.\n[...]\nPi ships with powerful defaults but skips features like sub-agents and plan mode. Ask Pi to build what you want, or install a package that does it your way.\n[...]\nAGENTS.md: Project instructions loaded at startup from`~/.pi/agent/`, parent directories, and the current directory.\n[...]\nDon't want to build it? Ask Pi to build it for you. Or install a package that does it your way. See the 50+ examples.\n[...]\nBundle extensions, skills, prompts, and themes as packages. Install from npm or git:\n[...]\n`$ pi install npm:@foo/pi-tools$ pi install git:github.com/badlogic/pi-doom`\n[...]\nSpawn Pi instances via tmux, or build your own with extensions, or install a package that does it your way.\n[...]\nWrite plans to files, or build it with extensions, or install a package.","error":null},{"url":"https://github.com/earendil-works/pi/blob/main/packages/coding-agent/docs/index.md","title":"packages/coding-agent/docs/index.md at main · earendil-works/pi","content":"Pi is a\n[...]\nterminal coding harness. It is designed to\n[...]\nthe core while being extended through TypeScript extensions, skills, prompt templates, themes\n[...]\nOn linux or mac you can install Pi with curl:\n[...]\n```bash\ncurl -fsSL https://pi.dev/install.sh | sh\n```\n[...]\nOr alternatively with npm:\n[...]\n```bash\nnpm install -g @earendil-works/pi-coding-agent\n```\n[...]\nThen run it in a project directory:\n[...]\n```bash\npi\n```\n[...]\nAuthenticate with `/login` for subscription providers, or set an API key such as `ANTHROPIC_API_KEY` before starting pi.\n[...]\n- Quickstart - install, authenticate, and run a first session.\n- Using Pi - interactive mode, slash commands, context files, and CLI reference.\n- Providers - subscription and API-key setup for built-in providers.\n- Settings - global and project settings.\n- Keybindings - default shortcuts and custom keybindings.\n- Sessions - session management, branching, and tree navigation.\n- Compaction - context compaction and branch summarization.","error":null},{"url":"https://github.com/badlogic/pi-mono/blob/main/packages/coding-agent/docs/settings.md","title":"packages/coding-agent/docs/settings.md at main · earendil-works/pi","content":"Pi uses JSON settings files with project settings overriding global settings.\n[...]\n| Location | Scope |\n|----------|-------|\n| `~/.pi/agent/settings.json` | Global (all projects) |\n| `.pi/settings.json` | Project (current directory) |\n[...]\nEdit directly or use `/settings` for common options.\n[...]\n| Setting | Type | Default | Description |\n|---------|------|---------|-------------|\n| `shellPath` | string | - | Custom shell path (e.g., for Cygwin on Windows) |\n| `shellCommandPrefix` | string | - | Prefix for every bash command (e.g., `\"shopt -s expand_aliases\"`) |\n| `npmCommand` | string[] | - | Command argv used for npm package lookup/install operations (e.g., `[\"mise\", \"exec\", \"node@20\", \"--\", \"npm\"]`) |\n[...]\n`npmCommand` is used for all npm package-manager operations, including installs, uninstalls, and dependency installs inside git packages. Use argv-style entries exactly as the process should be launched. When `npmCommand` is configured, git package dependency installs use plain `install` to avoid npm-specific flags in wrappers or alternate package managers.\n[...]\nThese settings define where to load extensions, skills, prompts, and themes from.\n[...]\nPaths in `~/.pi/agent/settings.json` resolve relative to `~/.pi/agent`. Paths in `.pi/settings.json` resolve relative to `.pi`. Absolute paths and `~` are supported.\n[...]\n| Setting | Type | Default | Description |\n|---------|------|---------|-------------|\n| `packages` | array | `[]` | npm/git packages to load resources from |\n| `extensions` | string[] | `[]` | Local extension file paths or directories |\n| `skills` | string[] | `[]` | Local skill file paths or directories |\n| `prompts` | string[] | `[]` | Local prompt template paths or directories |\n| `themes` | string[] | `[]` | Local theme file paths or directories |\n| `enableSkillCommands` | boolean | `true` | Register skills as `/skill:name` commands |\n[...]\nString form loads all resources from a package:\n[...]\n```json\n{\n  \"packages\": [\"pi-skills\", \"@org/my-extension\"]\n}\n[...]\nto load:\n[...]\n```json\n{\n  \"packages\": [\n    {\n      \"source\": \"\n[...]\n-skills\",\n      \"skills\": [\"brave-search\", \"transcribe\"],\n      \"extensions\": []\n    }\n  ]\n}\n[...]\n## Project Overrides\n[...]\nProject settings (`.pi/settings.json`) override global settings. Nested objects are merged:\n[...]\n```json\n// ~/.pi/agent/settings.json (global)\n{\n  \"theme\": \"dark\",\n  \"compaction\": { \"enabled\": true, \"reserveTokens\": 16384 }\n}\n\n// .pi/settings.json (project)\n{\n  \"compaction\": { \"reserveTokens\": 8192 }\n}\n\n// Result\n{\n  \"theme\": \"dark\",\n  \"compaction\": { \"enabled\": true, \"reserveTokens\": 8192 }\n}\n```","error":null},{"url":"https://github.com/badlogic/pi-mono/blob/main/packages/coding-agent/docs/packages.md","title":"packages/coding-agent/docs/packages.md at main · earendil-works/pi","content":"Pi packages bundle extensions, skills, prompt templates, and themes so you can share them through npm or git. A package can declare resources in `package.json` under the `pi` key, or use conventional directories.\n[...]\n- Install and Manage\n- Package Sources\n- Creating a Pi Package\n- Package Structure\n- Dependencies\n- Package Filtering\n- Enable and Disable Resources\n- Scope and Deduplication\n[...]\n## Package Filtering\n[...]\nFilter what a package loads using the object form in settings:\n\n```json\n{\n  \"packages\": [\n    \"npm:simple-pkg\",\n    {\n      \"source\": \"npm:my-package\",\n      \"extensions\": [\"extensions/*.ts\", \"!extensions/legacy.ts\"],\n      \"skills\": [],\n      \"prompts\": [\"prompts/review.md\"],\n      \"themes\": [\"+themes/legacy.json\"]\n    }\n  ]\n}\n```\n[...]\n`+path` and `-path` are exact paths relative to the package root.\n[...]\n- Omit a key to load all of that type.\n- Use `[]` to load none of that type.\n- `!pattern` excludes matches.\n- `+path` force-includes an exact path.\n- `-path` force-excludes an exact path.\n- Filters layer on top of the manifest. They narrow down what is already allowed.\n[...]\n## Enable and Disable Resources\n[...]\nUse `pi config` to enable or disable extensions, skills, prompt templates, and themes from installed packages and local directories. Works for both global (`~/.pi/agent`) and project (`.pi/`) scopes.","error":null},{"url":"https://github.com/badlogic/pi-mono/blob/main/packages/coding-agent/docs/usage.md","title":"packages/coding-agent/docs/usage.md at main · earendil-works/pi","content":"```bash\npi install <source> [-l]     # Install package, -l for project-local\npi remove <source> [-l]      # Remove package\npi uninstall <source> [-l]   # Alias for remove\npi update [source|self|pi]   # Update pi and packages; skips pinned packages\npi update --extensions       # Update packages only\npi update --self             # Update pi only\npi update --extension <src>  # Update one package\npi list                      # List installed packages\npi config                    # Enable/disable package resources\n```\n[...]\nSee Pi Packages for package sources and security notes.\n[...]\n### Resource Options\n[...]\n| Option | Description |\n|--------|-------------|\n| `-e`, `--extension ` | Load an extension from path, npm, or git; repeatable |\n| `--no-extensions` | Disable extension discovery |\n| `--skill ` | Load a skill; repeatable |\n| `--no-skills` | Disable skill discovery |\n| `--prompt-template ` | Load a prompt template; repeatable |\n| `--no-prompt-templates` | Disable prompt template discovery |\n| `--theme ` | Load a theme; repeatable |\n| `--no-themes` | Disable theme discovery |\n| `--no-context-files`, `-nc` | Disable `AGENTS.md` and `CLAUDE.md` discovery |\n[...]\nCombine `--no-*` with explicit flags to load exactly what you need, ignoring settings. Example:\n[...]\n```bash\npi --no-extensions -e ./my-extension.ts\n[...]\n| Description |\n|----------|-------------|\n| `PI_CODING_AGENT_DIR` | Override config directory; default is `~/.pi/agent` |\n| `PI_CODING_AGENT_SESSION_DIR` | Override session storage directory; overridden by `--session-dir` |\n| `PI_PACKAGE_DIR` | Override package directory, useful for Nix/Guix store paths |\n| `PI_OFFLINE` | Disable startup network operations, including update checks, package\n[...]\nchecks, and install/update telemetry |\n| `PI_SKIP_VERSION_CHECK` | Skip the Pi version update check at startup. This prevents the `pi.dev` latest-version request |\n| `PI_TELEMETRY` | Override install/update telemetry: `1`/`true`/`yes` or `0`/`false`/`no`. This does\n[...]\ndisable update checks |\n| `PI_CACHE_RETENTION` | Set to `long` for extended prompt cache where supported |\n| `VISUAL`, `EDITOR` | External editor for Ctrl+G |","error":null},{"url":"https://github.com/badlogic/pi-mono/blob/main/packages/coding-agent/docs/settings.md","title":"packages/coding-agent/docs/settings.md at main · earendil-works/pi","content":"----------|-------|\n[...]\nThese settings define where to load extensions, skills, prompts, and themes from.\n\nPaths in `~/.pi/agent/settings.json` resolve relative to `~/.pi/agent`. Paths in `.pi/settings.json` resolve relative to `.pi`. Absolute paths and `~` are supported.\n[...]\n| Setting | Type | Default | Description |\n|---------|------|---------|-------------|\n| `packages` | array | `[]` | npm/git packages to load resources from |\n| `extensions` | string[] | `[]` | Local extension file paths or directories |\n| `skills` | string[] | `[]` | Local skill file paths or directories |\n| `prompts` | string[] | `[]` | Local prompt template paths or directories |\n| `themes` | string[] | `[]` | Local theme file paths or directories |\n| `enableSkillCommands` | boolean | `true` | Register skills as `/skill:name` commands |\n[...]\nArrays support glob patterns and exclusions. Use `!pattern` to exclude. Use `+path` to force-include an exact path and `-path` to force-exclude an exact path.\n[...]\nString form loads all resources from a package:\n[...]\n```json\n{\n  \"packages\": [\"pi-skills\", \"@org/my-extension\"]\n}\n[...]\nObject form filters which resources to load:\n[...]\n```json\n{\n  \"packages\": [\n    {\n      \"source\": \"pi-skills\",\n      \"skills\": [\"brave-search\", \"transcribe\"],\n      \"extensions\": []\n    }\n  ]\n}\n```\n[...]\nSee packages.md for package management details.\n[...]\n```json\n{\n  \"defaultProvider\": \"anthropic\",\n  \"defaultModel\": \"claude-sonnet-4-20250514\",\n  \"defaultThinkingLevel\": \"medium\",\n  \"theme\": \"dark\",\n  \"compaction\": {\n    \"enabled\": true,\n    \"reserveTokens\": 16384,\n    \"keepRecentTokens\": 20000\n  },\n  \"retry\": {\n    \"enabled\": true,\n    \"maxRetries\": 3\n  },\n  \"enabledModels\": [\"claude-*\", \"gpt-4o\"],\n  \"warnings\": {\n    \"anthropicExtraUsage\": true\n  },\n  \"packages\": [\"pi-skills\"]\n}\n[...]\n## Project Overrides\n[...]\nProject settings (`.pi/settings.json`) override global settings. Nested objects are merged:","error":null},{"url":"https://github.com/earendil-works/pi/blob/main/packages/coding-agent/docs/settings.md","title":"packages/coding-agent/docs/settings.md at main · earendil-works/pi","content":"----------|-------|\n[...]\nThese settings define where to load extensions, skills, prompts, and themes from.\n\nPaths in `~/.pi/agent/settings.json` resolve relative to `~/.pi/agent`. Paths in `.pi/settings.json` resolve relative to `.pi`. Absolute paths and `~` are supported.\n[...]\n| Setting | Type | Default | Description |\n|---------|------|---------|-------------|\n| `packages` | array | `[]` | npm/git packages to load resources from |\n| `extensions` | string[] | `[]` | Local extension file paths or directories |\n| `skills` | string[] | `[]` | Local skill file paths or directories |\n| `prompts` | string[] | `[]` | Local prompt template paths or directories |\n| `themes` | string[] | `[]` | Local theme file paths or directories |\n| `enableSkillCommands` | boolean | `true` | Register skills as `/skill:name` commands |\n[...]\nArrays support glob patterns and exclusions. Use `!pattern` to exclude. Use `+path` to force-include an exact path and `-path` to force-exclude an exact path.\n[...]\nString form loads all resources from a package:\n[...]\n```json\n{\n  \"packages\": [\"pi-skills\", \"@org/my-extension\"]\n}\n[...]\nObject form filters which resources to load:\n[...]\n```json\n{\n  \"packages\": [\n    {\n      \"source\": \"pi-skills\",\n      \"skills\": [\"brave-search\", \"transcribe\"],\n      \"extensions\": []\n    }\n  ]\n}\n```\n[...]\nSee packages.md for package management details.\n[...]\n```json\n{\n  \"defaultProvider\": \"anthropic\",\n  \"defaultModel\": \"claude-sonnet-4-20250514\",\n  \"defaultThinkingLevel\": \"medium\",\n  \"theme\": \"dark\",\n  \"compaction\": {\n    \"enabled\": true,\n    \"reserveTokens\": 16384,\n    \"keepRecentTokens\": 20000\n  },\n  \"retry\": {\n    \"enabled\": true,\n    \"maxRetries\": 3\n  },\n  \"enabledModels\": [\"claude-*\", \"gpt-4o\"],\n  \"warnings\": {\n    \"anthropicExtraUsage\": true\n  },\n  \"packages\": [\"pi-skills\"]\n}\n[...]\n## Project Overrides\n[...]\nProject settings (`.pi/settings.json`) override global settings. Nested objects are merged:","error":null},{"url":"https://github.com/badlogic/pi-mono/issues/1044","title":"Empty array in package filter should disable all resources, not fall back to defaults · Issue #1044 · badlogic/pi-mono","content":"## Empty array in package filter should disable all resources, not fall back to defaults\n[...]\nSo I added github.com/tmustier/pi-extensions/ to my local setup, and specifically configured that i only want the arcade extension, so my `settings.json` looks like this:\n[...]\n```\n\"packages\": [\n \"/Users/lars/GitHub/agent-stuff\",\n {\n \"source\": \"git:github.com/tmustier/pi-extensions\",\n  \"extensions\": [\n  \"arcade/spice-invaders.ts\",\n  \"arcade/picman.ts\",\n  \"arcade/ping.ts\",\n  \"arcade/tetris.ts\",\n  \"arcade/mario-not/mario-not.ts\"\n  ],\n  \"skills\": []\n  }\n  ]\n```\n[...]\nInitially I didnt have `\"skills\": []` but that was the first \"fix\" which the clanker suggested, but that also didnt work.\n[...]\nWhen configuring a package with an empty array for a resource type (e.g., `\"skills\": []`), it should disable all resources of that type. Instead, it falls back to manifest defaults.\n[...]\n**Config:**\n[...]\n```json\n{\n  \"source\": \"git:github.com/tmustier/pi-extensions\",\n  \"extensions\": [\"arcade/spice-invaders.ts\", ...],\n  \"skills\": []\n}\n```\n[...]\n**Expected:** No skills loaded from this package\n[...]\n**Actual:** ralph-wiggum skill is still loaded\n[...]\nIn `package-manager.ts`, `applyPackageFilter` treats empty array as \"no patterns\":\n[...]\n```typescript\nif (userPatterns.length === 0) {\n    // No user patterns, just use manifest filtering\n    for (const f of allFiles) {\n        this.addResource(target, f, metadata, enabledByManifest.has(f));\n    }\n    return;\n}\n```\n[...]\n> The recommended way to disable parts of a pi package is to use pi config post install. However, skills: [] should indeed disable all skills in this package by default, so you found a bug.\n[...]\n> Fixed in main, thanks for reporting.","error":null},{"url":"https://github.com/badlogic/pi-mono/issues/951","title":"Overriding manifest disable for dependency extensions · Issue #951 · badlogic/pi-mono","content":"- `pi install npm:pi-package-test`\n- `pi config`\n- navigate to `status-bar` and enable.\n- Hit `Esc` key\n- `pi config` (again)\n- navigate to `status-bar`\n[...]\nPath B: use the manifest disable statements to hide them in `pi config` so the user is never presented an option to enable.\n[...]\nIt is confusing for the user to see an option on `pi config`, enable it and not see it being applied, even more confusing going back to the config screen and seeing it disabled.\n[...]\nas mentioned there are two\n[...]\nThe one i\n[...]\nadd a +extension to force-load it\n[...]\nScenario 1: Enable a resource disabled by manifest\n - item.enabled = false, hadUserExclusion = false, hadForceInclude = false\n - enabled = true → adds +pattern ✓\n[...]\nScenario 2: Disable a resource that was force-included (was manifest-disabled)\n - item.enabled = true (via +pattern), hadForceInclude = true\n - enabled = false → just removes +pattern, no !pattern added ✓\n - Manifest exclusion takes effect again\n[...]\nhadForceInclude\n[...]\n→ adds !pattern\n[...]\n> Fixed in ea93e2f3.\n> \n> Went with a modified version of path A. Changes:\n> \n> 1. **Manifest exclusions are final** - resources excluded by the manifest don't appear in `pi config` at all. They can't be overridden via config UI. If you need to use them, install the dependency directly or manually edit settings.json.\n> \n> 1. **New pattern operators** - `+path` (force include) and `-path` (force exclude) are now exact path matches, not globs. Precedence: force exclude > force include > exclude > include.\n> \n> 1. **Config toggle behavior** - enabling writes `+path`, disabling writes `-path`. Both use relative paths to the package root.\n> \n> 1. **Settings path resolution fix** - paths in `~/.pi/agent/settings.json` now resolve relative to `~/.pi/agent`, and paths in `.pi/settings.json` resolve relative to `.pi`. This was broken before (both resolved relative to cwd).\n> \n> The original issue mentioned `status-bar` but that file doesn't exist in pi-package-test. The package has `status-widget.ts` which is excluded by the shitty-extensions manifest. With this fix, it won't show in config at all.\n[...]\n> Follow-up fix in b270e7b5.\n> \n> Root cause was that config UI applied overrides only in the selector. Runtime loaders still auto-discovered defaults and ignored those overrides. That meant `pi config` toggles for auto-discovered prompts, skills, and extensions never took effect.\n> \n> Changes:\n> \n> - Package manager now auto-discovers top-level resources and applies `!`, `+`, and `-` overrides.\n> - Config selector uses resolved paths directly, no extra auto-discovery.\n> - Resource loader now uses resolved paths for extensions, skills, prompts, and themes so toggles actually control runtime loading.\n> - Skill and prompt source labels stay \"user\" and \"project\" when loaded via resolved paths.\n> \n> This fixes the mismatch shown in the screenshot.\n[...]\n> awesome!\n> a couple of notes:\n> \n> > Manifest exclusions are final - resources excluded by the manifest don't appear in pi config at all. They can't be overridden via config UI. If you need to use them, install the dependency directly or manually edit settings.json.\n> \n> that would be path B, right? not showing anything not specifically installed. I wasn't sure which one would be the Pi way. learning a bit more each day ;)\n> \n> > The original issue mentioned status-bar but that file doesn't exist in pi-package-test. The package has status-widget.ts which is excluded by the shitty-extensions manifest. With this fix, it won't show in config at all.\n> \n> No, it isn't directly. But the test package shows dependencies and has one with shitty-code-extensions that implements that and it is picking it up from the node_modules from the installed extension (pi-package-test), which had a manifest prohibiting the deps extensions. (pi-package-test -> shitty-code-extensions -> status-bar)\n> \n> Anyway, glad it is solved. I'l take a look at some of the changes","error":null},{"url":"https://github.com/badlogic/pi-mono/issues/938","title":"Add pi config TUI to manage package resources · Issue #938","content":"## Add pi config TUI to manage package resources\n[...]\nAdd a new `pi config` CLI command that opens a TUI for enabling and disabling package resources and top-level resources. It should list all resources with enabled state based on settings patterns and update user or project settings using `!` and `+` patterns.\n[...]\n- **CLI**: Add `pi config` command to `main.ts` and update help output. Mirror the `--resume` pattern by using a standalone TUI in `packages/coding-agent/src/cli/config-selector.ts`.\n- **TUI**: Implement a custom component that groups resources by package and by top-level scope. Follow `docs/tui.md` rules and reuse patterns from `SessionSelectorComponent` where applicable.\n- **Settings**: Update `settings.json` for user or project based on resource metadata. Use `!pattern` to disable and `+pattern` to re-enable. Preserve existing patterns and avoid duplicates.\n[...]\n- Add a `config` command in `main.ts` command parsing similar to `install/remove/update/list`.\n- Add a `selectConfig` function in `packages/coding-agent/src/cli/config-selector.ts` mirroring `session-picker.ts`.\n- Stop the standalone TUI and exit cleanly when the user closes the config UI.\n- Update help output in `packages/coding-agent/src/cli/args.ts`.\n[...]\n- Use `DefaultPackageManager.resolve()` which now returns `ResolvedResource[]` with `path`, `enabled`, `metadata`.\n- Create a grouped view model for UI:\n[...]\n- Package groups: by `metadata.source` and `metadata.scope` where `origin === \"package\"`.\n - Top-level groups: by `metadata.scope` where `origin === \"top-level\"`.\n - Within each group, list extensions, skills, prompts, themes.\n[...]\n- **Top-level resources** (origin: top-level):\n[...]\n- Update `extensions`, `skills`, `prompts`, `themes` arrays in user or project settings.\n - Disable: add `! ` matching the resource.\n - Enable: add `+ ` to override exclusions.\n - Use the shortest stable pattern, prefer relative path, fall back to basename.\n - Remove opposite patterns when toggling (avoid both `!foo` and `+foo`).\n[...]\n- **Package resources** (origin: package):\n[...]\n- Convert string package entry to object form on first edit.\n - Update the relevant resource array in the package filter object.\n - Add `!pattern` or `+pattern` based on toggle.\n - Use paths relative to the package root for stable matching.\n[...]\n- Create a custom component in `packages/coding-agent/src/cli/config-selector.ts` or `packages/coding-agent/src/modes/interactive/components/config-selector.ts`.\n- Display grouped list with headers and resource rows.\n- Keyboard actions:\n[...]\n- Handle resources disabled by manifest patterns and re-enabled via `+pattern`.\n- Avoid adding duplicate patterns.\n- Ensure settings updates are persisted via `SettingsManager`.\n- Ensure CLI does not start an AgentSession when `pi config` runs.\n[...]\ncustom components and theming\n[...]\na custom component is acceptable.","error":null},{"url":"https://github.com/Dicklesworthstone/pi_agent_rust/blob/main/docs/packages.md","title":"docs/packages.md at main · Dicklesworthstone/pi_agent_rust","content":"## Resource Discovery\n[...]\nWhen a package is installed, Pi looks for resources in the following locations within the package root:\n[...]\n`skills/`\n[...]\n`prompts/`\n[...]\nYou can manually configure packages in `settings.json`:\n\n```json\n{\n  \"packages\": [\n    \"npm:pi-skills\",\n    {\n      \"source\": \"git:github.com/org/repo\",\n      \"skills\": [\"relevant-skill\"],\n      \"extensions\": [] \n    }\n  ]\n}\n```\n[...]\nThe object form allows filtering which resources are loaded (allowlisting). If a field is omitted,\nall resources of that type are loaded. If a field is present but empty, **no** resources of that\ntype are enabled.\n[...]\n### Filter Patterns\n[...]\nFilter values can be strings or arrays. They accept glob-like patterns relative to the package\nroot, with optional prefixes:\n[...]\n- `pattern` → include matches (if any include patterns exist)\n- `!pattern` → exclude matches\n- `+pattern` → **force include** (exact path match)\n- `-pattern` → **force exclude** (exact path match)\n[...]\n```json\n{\n  \"packages\": [\n    {\n      \"source\": \"git:github.com/org/repo\",\n      \"extensions\": [\"dist/*.js\", \"!dist/experimental.js\"],\n      \"skills\": []\n    }\n  ]\n}\n```","error":null}]},"id":"334c983a","parentId":"54cdb25e","timestamp":"2026-05-16T13:03:52.725Z"}
{"type":"custom","customType":"web-search-results","data":{"id":"mp8cxuoowrouej","type":"search","timestamp":1778936632728,"queries":[{"query":"\"registerCommand\" \"pi.registerCommand\" \"pi install\" extension command examples","answer":"```ts /** * Commands Extension * * Demonstrates the pi.getCommands() API by providing a /commands command * that lists all available slash commands in the current session. * * Usage: * 1. Copy this file to ~/.pi/agent/extensions/ or your project's .pi/extensions/ * 2. Use /commands to see available commands * 3. Use /commands extensions to filter by source */ [...] import type { ExtensionAPI, SlashCommandInfo } from \"@mariozechner/pi-coding-agent\"; [...] export default function commandsExtension\nSource: packages/coding-agent/examples/extensions/commands.ts at main · badlogic/pi-mono (https://github.com/badlogic/pi-mono/blob/main/packages/coding-agent/examples/extensions/commands.ts)\n\n```typescript import type { ExtensionAPI } from \"@mariozechner/pi-coding-agent\"; export default function (pi: ExtensionAPI) { pi.registerCommand(\"ping\", { description: \"Ping the extension\", handler: async (_args, ctx) => { ctx.ui.notify(\"pong\", \"info\"); }, }); } ``` [...] ## P6. Command Registration [...] ```typescript pi.registerCommand(\"deploy\", { description: \"Deploy to environment\", handler: async (args, ctx) => { const env = args.trim() || \"staging\"; ctx.ui.notify(`Deploying to ${env}...`, \nSource: PATTERNS.md at main · Dwsy/pi-extensions-skill (https://github.com/Dwsy/pi-extensions-skill/blob/main/PATTERNS.md)\n\n- Custom tools - Register tools the LLM can call via`pi.registerTool()` - Event interception - Block or modify tool calls, inject context, customize compaction - User interaction - Prompt users via`ctx.ui`(select, confirm, input, notify) - Custom UI components - Full TUI components with keyboard input via`ctx.ui.custom()` for complex interactions - Custom commands - Register commands like`/mycommand` via`pi.registerCommand()` - Session persistence - Store state that survives restarts via`pi.appe\nSource: Extensions - Pi Coding Agent (https://pi.dev/docs/latest/extensions)\n\n- **Custom tools** - Register tools the LLM can call via `pi.registerTool()` - **Event interception** - Block or modify tool calls, inject context, customize compaction - **User interaction** - Prompt users via `ctx.ui` (select, confirm, input, notify) - **Custom UI components** - Full TUI components with keyboard input via `ctx.ui.custom()` for complex interactions - **Custom commands** - Register commands like `/mycommand` via `pi.registerCommand()` - **Session persistence** - Store state that\nSource: packages/coding-agent/docs/extensions.md at main · earendil-works/pi (https://github.com/earendil-works/pi/blob/main/packages/coding-agent/docs/extensions.md)\n\n```typescript import type { ExtensionAPI } from \"@mariozechner/pi-coding-agent\"; export default function (pi: ExtensionAPI) { // Register event handlers, tools, commands, flags pi.on(\"tool_call\", async (event, ctx) => { // Intercept tool calls }); pi.registerCommand(\"my-command\", { description: \"Does something\", handler: async (args, ctx) => { ctx.ui.notify(\"Hello!\", \"info\"); }, }); } ``` [...] | Method | Purpose | |--------|---------| | `pi.on(\"tool_call\", handler)` | Intercept tool calls befor\nSource: HowTo.md at main · sysid/pi-extensions (https://github.com/sysid/pi-extensions/blob/main/HowTo.md)\n\nYou can create custom extensions for the Pi coding agent by writing a TypeScript or JavaScript module that exports a default factory function receiving an`ExtensionAPI` object, allowing you to register tools, commands, and lifecycle hooks. [...] - Registration methods –`on()`,`registerTool()`,`registerCommand()`,`registerShortcut()`,`registerFlag()`,`registerMessageRenderer()` - Flag access –`getFlag()` to read configuration values - Action methods –`sendMessage()`,`exec()`,`setLabel()`,`setMode\nSource: How to Create Custom Extensions for the Pi Coding Agent: A Complete Guide | pi-mono | Instagit (https://instagit.com/badlogic/pi-mono/how-to-create-custom-extensions-for-pi-coding-agent/)\n\n- **Custom tools** - Register tools the LLM can call via `pi.registerTool()` - **Event interception** - Block or modify tool calls, inject context, customize compaction - **User interaction** - Prompt users via `ctx.ui` (select, confirm, input, notify) - **Custom UI components** - Full TUI components with keyboard input via `ctx.ui.custom()` for complex interactions - **Custom commands** - Register commands like `/mycommand` via `pi.registerCommand()` - **Session persistence** - Store state that\nSource: packages/coding-agent/docs/extensions.md at main · earendil-works/pi (https://github.com/badlogic/pi-mono/blob/main/packages/coding-agent/docs/extensions.md)\n\n### Local Extension Folder [...] Copy this repository to one of the following locations: [...] ```text ~/.pi/agent/extensions/pi-must-have-extension # Global default (when PI_CODING_AGENT_DIR is unset) .pi/extensions/pi-must-have-extension # Project-specific ``` [...] Pi will auto-discover the extension on startup. [...] ### NPM Package [...] ```bash pi install npm:pi-must-have-extension ``` [...] automatically. When [...] type prompts containing [...] The extension does not transform: [...] - S\nSource: pi-must-have-extension (https://registry.npmjs.org/pi-must-have-extension)","results":[{"title":"packages/coding-agent/examples/extensions/commands.ts at main · badlogic/pi-mono","url":"https://github.com/badlogic/pi-mono/blob/main/packages/coding-agent/examples/extensions/commands.ts","snippet":""},{"title":"PATTERNS.md at main · Dwsy/pi-extensions-skill","url":"https://github.com/Dwsy/pi-extensions-skill/blob/main/PATTERNS.md","snippet":""},{"title":"Extensions - Pi Coding Agent","url":"https://pi.dev/docs/latest/extensions","snippet":""},{"title":"packages/coding-agent/docs/extensions.md at main · earendil-works/pi","url":"https://github.com/earendil-works/pi/blob/main/packages/coding-agent/docs/extensions.md","snippet":""},{"title":"HowTo.md at main · sysid/pi-extensions","url":"https://github.com/sysid/pi-extensions/blob/main/HowTo.md","snippet":""},{"title":"How to Create Custom Extensions for the Pi Coding Agent: A Complete Guide | pi-mono | Instagit","url":"https://instagit.com/badlogic/pi-mono/how-to-create-custom-extensions-for-pi-coding-agent/","snippet":""},{"title":"packages/coding-agent/docs/extensions.md at main · earendil-works/pi","url":"https://github.com/badlogic/pi-mono/blob/main/packages/coding-agent/docs/extensions.md","snippet":""},{"title":"pi-must-have-extension","url":"https://registry.npmjs.org/pi-must-have-extension","snippet":""}],"error":null,"provider":"exa"},{"query":"\"pi prompt templates\" \"argument-hint\" \"pi-prompt-template-model\"","answer":"# Repository: nicobailon/pi-prompt-template-model [...] Pi extension: Add model frontmatter to prompt templates for automatic model switching [...] Adds `model`, `skill`, and `thinking` frontmatter to pi prompt templates. Define slash commands that switch to the right model, set a thinking level, inject skill context, and auto-restore your session when done. [...] ```bash pi install npm:pi-prompt-template-model ``` [...] Add `model` and optionally `skill` to any prompt template: [...] ## Frontma\nSource: nicobailon/pi-prompt-template-model (https://github.com/nicobailon/pi-prompt-template-model)\n\n## feat(coding-agent,tui): support argument-hint frontmatter in prompt templates [...] Parse `argument-hint` from prompt template frontmatter and display it in the autocomplete dropdown, so users can see what arguments a command expects before invoking it. [...] ## Frontmatter format [...] Use ` ` for required arguments and `[square brackets]` for optional ones: [...] ```yaml --- description: Review PRs from URLs with structured issue and code analysis argument-hint: \"<PR-URL>\" --- ``` [...] The\nSource: feat(coding-agent,tui): support argument-hint frontmatter in prompt templates · Pull Request #2780 · badlogic/pi-mono (https://github.com/badlogic/pi-mono/pull/2780)\n\n## Support argument-hint frontmatter in prompt templates [...] ## Feature: Support `argument-hint` frontmatter in prompt templates [...] Parse `argument-hint` from prompt template frontmatter and display it as dim text in the autocomplete dropdown, matching Claude Code's behavior for custom commands. [...] When teams define custom slash commands (e.g., `/review`, `/ship`, `/ticket`), users have no way to discover what arguments the command accepts without reading the source file. Claude Code sol\nSource: Support argument-hint frontmatter in prompt templates · Issue #2761 · badlogic/pi-mono (https://github.com/badlogic/pi-mono/issues/2761)\n\nAdd model, skill, and thinking frontmatter to Pi prompt templates so slash commands switch modes automatically. [...] Pi-prompt-template-model extends Pi's built-in prompt templates with frontmatter like`model`,`skill`, and`thinking`. That lets a template become a reusable agent mode: run a single slash command and Pi can switch to the right model, preload a skill, adjust thinking depth, and restore your previous session settings when the task finishes. [...] The extension also supports more adv\nSource: Prompt Templates — LazyPi Docs (https://lazypi.org/docs/packages/prompt-templates.html)\n\n# pi-prompt-template-model [...] Prompt template model selector extension for pi coding agent [...] npm i pi-prompt-template-model [...] Adds `model`, `skill`, and `thinking` frontmatter to pi prompt templates. Define slash commands that switch to the right model, set a thinking level, inject skill context, and auto-restore your session when done. [...] pi install npm:pi-prompt-template-model [...] Add `model` and optionally `skill` to any prompt template: [...] ## Frontmatter Reference [...] Al\nSource: pi-prompt-template-model (https://registry.npmjs.org/pi-prompt-template-model)\n\nReleases · nicobailon/pi-prompt-template-model · GitHub [...] / pi-prompt-template-model Public [...] v0.7.0 [...] - Added a first-class`bestOfN:` prompt-template authoring surface for compare workflows, with configurable`workers`,`reviewers`, optional`finalApplier`, and nested`bestOfN.worktree` support. - Added configurable compare runtime overrides via`--workers`,`--reviewers`,`--workers-append`,`--reviewers-append`, and`--final-applier`. - Added`count: N` compare-slot shorthand so one worker \nSource: Releases · nicobailon/pi-prompt-template-model · GitHub (https://github.com/nicobailon/pi-prompt-template-model/releases)\n\n# File: nicobailon/pi-prompt-template-model/prompt-execution.ts [...] - Repository: nicobailon/pi-prompt-template-model | Pi extension: Add model frontmatter to prompt templates for automatic model switching | 151 stars | TypeScript - Branch: main [...] ```ts import type { Model } from \"@mariozechner/pi-ai\"; import { substituteArgs } from \"./args.js\"; import { getResolvedModelRef, selectModelCandidate, type RegistryLike, type SelectedModelCandidate } from \"./model-selection.js\"; import type { Pr\nSource: prompt-execution.ts at main · nicobailon/pi-prompt-template-model (https://github.com/nicobailon/pi-prompt-template-model/blob/main/prompt-execution.ts)\n\nRelevant source files [...] * .pi/prompts/is.md * .pi/prompts/pr.md * .pi/prompts/wr.md * packages/coding-agent/docs/prompt-templates.md * packages/coding-agent/docs/skills.md * packages/coding-agent/src/core/package-manager.ts * packages/coding-agent/src/core/prompt-templates.ts * packages/coding-agent/src/core/resource-loader.ts * packages/coding-agent/src/core/skills.ts * packages/coding-agent/src/utils/paths.ts [...] * packages/coding- [...] /test/fixtures/skills/root-skill-preferred/SKILL.m\nSource: Skills & Prompt Templates | badlogic/pi-mono | DeepWiki (https://deepwiki.com/badlogic/pi-mono/4.8-skills-and-prompt-templates)","results":[{"title":"nicobailon/pi-prompt-template-model","url":"https://github.com/nicobailon/pi-prompt-template-model","snippet":""},{"title":"feat(coding-agent,tui): support argument-hint frontmatter in prompt templates · Pull Request #2780 · badlogic/pi-mono","url":"https://github.com/badlogic/pi-mono/pull/2780","snippet":""},{"title":"Support argument-hint frontmatter in prompt templates · Issue #2761 · badlogic/pi-mono","url":"https://github.com/badlogic/pi-mono/issues/2761","snippet":""},{"title":"Prompt Templates — LazyPi Docs","url":"https://lazypi.org/docs/packages/prompt-templates.html","snippet":""},{"title":"pi-prompt-template-model","url":"https://registry.npmjs.org/pi-prompt-template-model","snippet":""},{"title":"Releases · nicobailon/pi-prompt-template-model · GitHub","url":"https://github.com/nicobailon/pi-prompt-template-model/releases","snippet":""},{"title":"prompt-execution.ts at main · nicobailon/pi-prompt-template-model","url":"https://github.com/nicobailon/pi-prompt-template-model/blob/main/prompt-execution.ts","snippet":""},{"title":"Skills & Prompt Templates | badlogic/pi-mono | DeepWiki","url":"https://deepwiki.com/badlogic/pi-mono/4.8-skills-and-prompt-templates","snippet":""}],"error":null,"provider":"exa"},{"query":"\"pi install -l\" project settings packages automatically on startup Pi Coding Agent","answer":"By default, `install` and `remove` write to global settings (`~/.pi/agent/settings.json`). Use `-l` to write to project settings (`.pi/settings.json`) instead. Project settings can be shared with your team, and pi installs any missing packages automatically on startup. [...] Use `pi config` to enable or disable extensions, skills, prompt templates, and themes from installed packages and local directories. Works for both global (`~/.pi/agent`) and project (`.pi/`) scopes. [...] Packages can appea\nSource: packages/coding-agent/docs/packages.md at main · earendil-works/pi (https://github.com/earendil-works/pi/blob/main/packages/coding-agent/docs/packages.md)\n\nPi uses JSON settings files with project settings overriding global settings. [...] | Location | Scope | |----------|-------| | `~/.pi/agent/settings.json` | Global (all projects) | | `.pi/settings.json` | Project (current directory) | [...] Edit directly or use `/settings` for common options. [...] | Setting | Type | Default | Description | |---------|------|---------|-------------| | `shellPath` | string | - | Custom shell path (e.g., for Cygwin on Windows) | | `shellCommandPrefix` | string | \nSource: packages/coding-agent/docs/settings.md at main · earendil-works/pi (https://github.com/earendil-works/pi/blob/main/packages/coding-agent/docs/settings.md)\n\n### Package Commands [...] ```bash pi install <source> [-l] # Install package, -l for project-local pi remove <source> [-l] # Remove package pi uninstall <source> [-l] # Alias for remove pi update [source|self|pi] # Update pi and packages; skips pinned packages pi update --extensions # Update packages only pi update --self # Update pi only pi update --extension <src> # Update one package pi list # List installed packages pi config # Enable/disable package resources ``` [...] | Variable | Descrip\nSource: packages/coding-agent/docs/usage.md at main · earendil-works/pi (https://github.com/badlogic/pi-mono/blob/main/packages/coding-agent/docs/usage.md)\n\n| Location | Scope | |----------|-------| [...] | `~/. [...] /agent/settings [...] ### Pi Packages [...] ```bash pi install npm:@foo/pi-tools pi install npm:@foo/pi-tools@1.2.3 # pinned version [...] pi update # [...] pi update --extensions [...] pi config # enable/ [...] extensions, skills, prompts, themes [...] Packages install to `~/.pi/agent/git/` (git) or global npm. Use `-l` for project-local installs (`.pi/git/`, `.pi/npm/`). Git packages install dependencies with `npm install --omit=dev`\nSource: heads/main/packages/coding-agent/README.md at refs · badlogic/pi-mono (https://github.com/badlogic/pi-mono/blob/refs/heads/main/packages/coding-agent/README.md)\n\nPi is distributed as an npm package: [...] ```bash npm install -g @earendil-works/pi-coding-agent ``` [...] Then start pi in the project directory you want it to work on: [...] ```bash cd /path/to/project pi ``` [...] ## Give pi project instructions [...] Pi loads context files at startup. Add an `AGENTS.md` file to tell it how to work in a project: [...] ```markdown # Project Instructions - Run `npm run check` after code changes. - Do not run production migrations locally. - Keep responses conc\nSource: packages/coding-agent/docs/quickstart.md at main · earendil-works/pi (https://github.com/earendil-works/pi/blob/main/packages/coding-agent/docs/quickstart.md)\n\nPi is a minimal terminal coding harness. Adapt Pi to your workflows, not the other way around. Customize Pi with extensions, skills, prompt templates, and themes. Bundle them as Pi packages and share via npm or git. [...] Pi ships with powerful defaults but skips features like sub-agents and plan mode. Ask Pi to build what you want, or install a package that does it your way. [...] AGENTS.md: Project instructions loaded at startup from`~/.pi/agent/`, parent directories, and the current directory\nSource: Pi Coding Agent (https://pi.dev/)\n\nPi is a [...] terminal coding harness. It is designed to [...] the core while being extended through TypeScript extensions, skills, prompt templates, themes [...] On linux or mac you can install Pi with curl: [...] ```bash curl -fsSL https://pi.dev/install.sh | sh ``` [...] Or alternatively with npm: [...] ```bash npm install -g @earendil-works/pi-coding-agent ``` [...] Then run it in a project directory: [...] ```bash pi ``` [...] Authenticate with `/login` for subscription providers, or set an\nSource: packages/coding-agent/docs/index.md at main · earendil-works/pi (https://github.com/earendil-works/pi/blob/main/packages/coding-agent/docs/index.md)\n\nPi uses JSON settings files with project settings overriding global settings. [...] | Location | Scope | |----------|-------| | `~/.pi/agent/settings.json` | Global (all projects) | | `.pi/settings.json` | Project (current directory) | [...] Edit directly or use `/settings` for common options. [...] | Setting | Type | Default | Description | |---------|------|---------|-------------| | `shellPath` | string | - | Custom shell path (e.g., for Cygwin on Windows) | | `shellCommandPrefix` | string | \nSource: packages/coding-agent/docs/settings.md at main · earendil-works/pi (https://github.com/badlogic/pi-mono/blob/main/packages/coding-agent/docs/settings.md)","results":[{"title":"packages/coding-agent/docs/packages.md at main · earendil-works/pi","url":"https://github.com/earendil-works/pi/blob/main/packages/coding-agent/docs/packages.md","snippet":""},{"title":"packages/coding-agent/docs/settings.md at main · earendil-works/pi","url":"https://github.com/earendil-works/pi/blob/main/packages/coding-agent/docs/settings.md","snippet":""},{"title":"packages/coding-agent/docs/usage.md at main · earendil-works/pi","url":"https://github.com/badlogic/pi-mono/blob/main/packages/coding-agent/docs/usage.md","snippet":""},{"title":"heads/main/packages/coding-agent/README.md at refs · badlogic/pi-mono","url":"https://github.com/badlogic/pi-mono/blob/refs/heads/main/packages/coding-agent/README.md","snippet":""},{"title":"packages/coding-agent/docs/quickstart.md at main · earendil-works/pi","url":"https://github.com/earendil-works/pi/blob/main/packages/coding-agent/docs/quickstart.md","snippet":""},{"title":"Pi Coding Agent","url":"https://pi.dev/","snippet":""},{"title":"packages/coding-agent/docs/index.md at main · earendil-works/pi","url":"https://github.com/earendil-works/pi/blob/main/packages/coding-agent/docs/index.md","snippet":""},{"title":"packages/coding-agent/docs/settings.md at main · earendil-works/pi","url":"https://github.com/badlogic/pi-mono/blob/main/packages/coding-agent/docs/settings.md","snippet":""}],"error":null,"provider":"exa"},{"query":"\"pi config\" enable disable resources Pi Coding Agent packages filtering","answer":"Pi packages bundle extensions, skills, prompt templates, and themes so you can share them through npm or git. A package can declare resources in `package.json` under the `pi` key, or use conventional directories. [...] - Install and Manage - Package Sources - Creating a Pi Package - Package Structure - Dependencies - Package Filtering - Enable and Disable Resources - Scope and Deduplication [...] ## Package Filtering [...] Filter what a package loads using the object form in settings: ```json { \nSource: packages/coding-agent/docs/packages.md at main · earendil-works/pi (https://github.com/badlogic/pi-mono/blob/main/packages/coding-agent/docs/packages.md)\n\n```bash pi install <source> [-l] # Install package, -l for project-local pi remove <source> [-l] # Remove package pi uninstall <source> [-l] # Alias for remove pi update [source|self|pi] # Update pi and packages; skips pinned packages pi update --extensions # Update packages only pi update --self # Update pi only pi update --extension <src> # Update one package pi list # List installed packages pi config # Enable/disable package resources ``` [...] See Pi Packages for package sources and securit\nSource: packages/coding-agent/docs/usage.md at main · earendil-works/pi (https://github.com/badlogic/pi-mono/blob/main/packages/coding-agent/docs/usage.md)\n\n----------|-------| [...] These settings define where to load extensions, skills, prompts, and themes from. Paths in `~/.pi/agent/settings.json` resolve relative to `~/.pi/agent`. Paths in `.pi/settings.json` resolve relative to `.pi`. Absolute paths and `~` are supported. [...] | Setting | Type | Default | Description | |---------|------|---------|-------------| | `packages` | array | `[]` | npm/git packages to load resources from | | `extensions` | string[] | `[]` | Local extension file paths \nSource: packages/coding-agent/docs/settings.md at main · earendil-works/pi (https://github.com/badlogic/pi-mono/blob/main/packages/coding-agent/docs/settings.md)\n\n----------|-------| [...] These settings define where to load extensions, skills, prompts, and themes from. Paths in `~/.pi/agent/settings.json` resolve relative to `~/.pi/agent`. Paths in `.pi/settings.json` resolve relative to `.pi`. Absolute paths and `~` are supported. [...] | Setting | Type | Default | Description | |---------|------|---------|-------------| | `packages` | array | `[]` | npm/git packages to load resources from | | `extensions` | string[] | `[]` | Local extension file paths \nSource: packages/coding-agent/docs/settings.md at main · earendil-works/pi (https://github.com/earendil-works/pi/blob/main/packages/coding-agent/docs/settings.md)\n\n## Empty array in package filter should disable all resources, not fall back to defaults [...] So I added github.com/tmustier/pi-extensions/ to my local setup, and specifically configured that i only want the arcade extension, so my `settings.json` looks like this: [...] ``` \"packages\": [ \"/Users/lars/GitHub/agent-stuff\", { \"source\": \"git:github.com/tmustier/pi-extensions\", \"extensions\": [ \"arcade/spice-invaders.ts\", \"arcade/picman.ts\", \"arcade/ping.ts\", \"arcade/tetris.ts\", \"arcade/mario-not/mar\nSource: Empty array in package filter should disable all resources, not fall back to defaults · Issue #1044 · badlogic/pi-mono (https://github.com/badlogic/pi-mono/issues/1044)\n\n- `pi install npm:pi-package-test` - `pi config` - navigate to `status-bar` and enable. - Hit `Esc` key - `pi config` (again) - navigate to `status-bar` [...] Path B: use the manifest disable statements to hide them in `pi config` so the user is never presented an option to enable. [...] It is confusing for the user to see an option on `pi config`, enable it and not see it being applied, even more confusing going back to the config screen and seeing it disabled. [...] as mentioned there are two \nSource: Overriding manifest disable for dependency extensions · Issue #951 · badlogic/pi-mono (https://github.com/badlogic/pi-mono/issues/951)\n\n## Add pi config TUI to manage package resources [...] Add a new `pi config` CLI command that opens a TUI for enabling and disabling package resources and top-level resources. It should list all resources with enabled state based on settings patterns and update user or project settings using `!` and `+` patterns. [...] - **CLI**: Add `pi config` command to `main.ts` and update help output. Mirror the `--resume` pattern by using a standalone TUI in `packages/coding-agent/src/cli/config-selector.t\nSource: Add pi config TUI to manage package resources · Issue #938 (https://github.com/badlogic/pi-mono/issues/938)\n\n## Resource Discovery [...] When a package is installed, Pi looks for resources in the following locations within the package root: [...] `skills/` [...] `prompts/` [...] You can manually configure packages in `settings.json`: ```json { \"packages\": [ \"npm:pi-skills\", { \"source\": \"git:github.com/org/repo\", \"skills\": [\"relevant-skill\"], \"extensions\": [] } ] } ``` [...] The object form allows filtering which resources are loaded (allowlisting). If a field is omitted, all resources of that type are \nSource: docs/packages.md at main · Dicklesworthstone/pi_agent_rust (https://github.com/Dicklesworthstone/pi_agent_rust/blob/main/docs/packages.md)","results":[{"title":"packages/coding-agent/docs/packages.md at main · earendil-works/pi","url":"https://github.com/badlogic/pi-mono/blob/main/packages/coding-agent/docs/packages.md","snippet":""},{"title":"packages/coding-agent/docs/usage.md at main · earendil-works/pi","url":"https://github.com/badlogic/pi-mono/blob/main/packages/coding-agent/docs/usage.md","snippet":""},{"title":"packages/coding-agent/docs/settings.md at main · earendil-works/pi","url":"https://github.com/badlogic/pi-mono/blob/main/packages/coding-agent/docs/settings.md","snippet":""},{"title":"packages/coding-agent/docs/settings.md at main · earendil-works/pi","url":"https://github.com/earendil-works/pi/blob/main/packages/coding-agent/docs/settings.md","snippet":""},{"title":"Empty array in package filter should disable all resources, not fall back to defaults · Issue #1044 · badlogic/pi-mono","url":"https://github.com/badlogic/pi-mono/issues/1044","snippet":""},{"title":"Overriding manifest disable for dependency extensions · Issue #951 · badlogic/pi-mono","url":"https://github.com/badlogic/pi-mono/issues/951","snippet":""},{"title":"Add pi config TUI to manage package resources · Issue #938","url":"https://github.com/badlogic/pi-mono/issues/938","snippet":""},{"title":"docs/packages.md at main · Dicklesworthstone/pi_agent_rust","url":"https://github.com/Dicklesworthstone/pi_agent_rust/blob/main/docs/packages.md","snippet":""}],"error":null,"provider":"exa"}]},"id":"4e47eac6","parentId":"334c983a","timestamp":"2026-05-16T13:03:52.728Z"}
{"type":"message","id":"bde1e2ed","parentId":"4e47eac6","timestamp":"2026-05-16T13:03:52.730Z","message":{"role":"toolResult","toolCallId":"call_zaX9zqrdam5ZZwXcf37WqfSl|fc_02f887b473d5faa9016a086b30746c8190a722ed0e8a59f303","toolName":"web_search","content":[{"type":"text","text":"## Query: \"\"registerCommand\" \"pi.registerCommand\" \"pi install\" extension command examples\"\n\n```ts /** * Commands Extension * * Demonstrates the pi.getCommands() API by providing a /commands command * that lists all available slash commands in the current session. * * Usage: * 1. Copy this file to ~/.pi/agent/extensions/ or your project's .pi/extensions/ * 2. Use /commands to see available commands * 3. Use /commands extensions to filter by source */ [...] import type { ExtensionAPI, SlashCommandInfo } from \"@mariozechner/pi-coding-agent\"; [...] export default function commandsExtension\nSource: packages/coding-agent/examples/extensions/commands.ts at main · badlogic/pi-mono (https://github.com/badlogic/pi-mono/blob/main/packages/coding-agent/examples/extensions/commands.ts)\n\n```typescript import type { ExtensionAPI } from \"@mariozechner/pi-coding-agent\"; export default function (pi: ExtensionAPI) { pi.registerCommand(\"ping\", { description: \"Ping the extension\", handler: async (_args, ctx) => { ctx.ui.notify(\"pong\", \"info\"); }, }); } ``` [...] ## P6. Command Registration [...] ```typescript pi.registerCommand(\"deploy\", { description: \"Deploy to environment\", handler: async (args, ctx) => { const env = args.trim() || \"staging\"; ctx.ui.notify(`Deploying to ${env}...`, \nSource: PATTERNS.md at main · Dwsy/pi-extensions-skill (https://github.com/Dwsy/pi-extensions-skill/blob/main/PATTERNS.md)\n\n- Custom tools - Register tools the LLM can call via`pi.registerTool()` - Event interception - Block or modify tool calls, inject context, customize compaction - User interaction - Prompt users via`ctx.ui`(select, confirm, input, notify) - Custom UI components - Full TUI components with keyboard input via`ctx.ui.custom()` for complex interactions - Custom commands - Register commands like`/mycommand` via`pi.registerCommand()` - Session persistence - Store state that survives restarts via`pi.appe\nSource: Extensions - Pi Coding Agent (https://pi.dev/docs/latest/extensions)\n\n- **Custom tools** - Register tools the LLM can call via `pi.registerTool()` - **Event interception** - Block or modify tool calls, inject context, customize compaction - **User interaction** - Prompt users via `ctx.ui` (select, confirm, input, notify) - **Custom UI components** - Full TUI components with keyboard input via `ctx.ui.custom()` for complex interactions - **Custom commands** - Register commands like `/mycommand` via `pi.registerCommand()` - **Session persistence** - Store state that\nSource: packages/coding-agent/docs/extensions.md at main · earendil-works/pi (https://github.com/earendil-works/pi/blob/main/packages/coding-agent/docs/extensions.md)\n\n```typescript import type { ExtensionAPI } from \"@mariozechner/pi-coding-agent\"; export default function (pi: ExtensionAPI) { // Register event handlers, tools, commands, flags pi.on(\"tool_call\", async (event, ctx) => { // Intercept tool calls }); pi.registerCommand(\"my-command\", { description: \"Does something\", handler: async (args, ctx) => { ctx.ui.notify(\"Hello!\", \"info\"); }, }); } ``` [...] | Method | Purpose | |--------|---------| | `pi.on(\"tool_call\", handler)` | Intercept tool calls befor\nSource: HowTo.md at main · sysid/pi-extensions (https://github.com/sysid/pi-extensions/blob/main/HowTo.md)\n\nYou can create custom extensions for the Pi coding agent by writing a TypeScript or JavaScript module that exports a default factory function receiving an`ExtensionAPI` object, allowing you to register tools, commands, and lifecycle hooks. [...] - Registration methods –`on()`,`registerTool()`,`registerCommand()`,`registerShortcut()`,`registerFlag()`,`registerMessageRenderer()` - Flag access –`getFlag()` to read configuration values - Action methods –`sendMessage()`,`exec()`,`setLabel()`,`setMode\nSource: How to Create Custom Extensions for the Pi Coding Agent: A Complete Guide | pi-mono | Instagit (https://instagit.com/badlogic/pi-mono/how-to-create-custom-extensions-for-pi-coding-agent/)\n\n- **Custom tools** - Register tools the LLM can call via `pi.registerTool()` - **Event interception** - Block or modify tool calls, inject context, customize compaction - **User interaction** - Prompt users via `ctx.ui` (select, confirm, input, notify) - **Custom UI components** - Full TUI components with keyboard input via `ctx.ui.custom()` for complex interactions - **Custom commands** - Register commands like `/mycommand` via `pi.registerCommand()` - **Session persistence** - Store state that\nSource: packages/coding-agent/docs/extensions.md at main · earendil-works/pi (https://github.com/badlogic/pi-mono/blob/main/packages/coding-agent/docs/extensions.md)\n\n### Local Extension Folder [...] Copy this repository to one of the following locations: [...] ```text ~/.pi/agent/extensions/pi-must-have-extension # Global default (when PI_CODING_AGENT_DIR is unset) .pi/extensions/pi-must-have-extension # Project-specific ``` [...] Pi will auto-discover the extension on startup. [...] ### NPM Package [...] ```bash pi install npm:pi-must-have-extension ``` [...] automatically. When [...] type prompts containing [...] The extension does not transform: [...] - S\nSource: pi-must-have-extension (https://registry.npmjs.org/pi-must-have-extension)\n\n---\n\n**Sources:**\n1. packages/coding-agent/examples/extensions/commands.ts at main · badlogic/pi-mono\n   https://github.com/badlogic/pi-mono/blob/main/packages/coding-agent/examples/extensions/commands.ts\n\n2. PATTERNS.md at main · Dwsy/pi-extensions-skill\n   https://github.com/Dwsy/pi-extensions-skill/blob/main/PATTERNS.md\n\n3. Extensions - Pi Coding Agent\n   https://pi.dev/docs/latest/extensions\n\n4. packages/coding-agent/docs/extensions.md at main · earendil-works/pi\n   https://github.com/earendil-works/pi/blob/main/packages/coding-agent/docs/extensions.md\n\n5. HowTo.md at main · sysid/pi-extensions\n   https://github.com/sysid/pi-extensions/blob/main/HowTo.md\n\n6. How to Create Custom Extensions for the Pi Coding Agent: A Complete Guide | pi-mono | Instagit\n   https://instagit.com/badlogic/pi-mono/how-to-create-custom-extensions-for-pi-coding-agent/\n\n7. packages/coding-agent/docs/extensions.md at main · earendil-works/pi\n   https://github.com/badlogic/pi-mono/blob/main/packages/coding-agent/docs/extensions.md\n\n8. pi-must-have-extension\n   https://registry.npmjs.org/pi-must-have-extension\n\n## Query: \"\"pi prompt templates\" \"argument-hint\" \"pi-prompt-template-model\"\"\n\n# Repository: nicobailon/pi-prompt-template-model [...] Pi extension: Add model frontmatter to prompt templates for automatic model switching [...] Adds `model`, `skill`, and `thinking` frontmatter to pi prompt templates. Define slash commands that switch to the right model, set a thinking level, inject skill context, and auto-restore your session when done. [...] ```bash pi install npm:pi-prompt-template-model ``` [...] Add `model` and optionally `skill` to any prompt template: [...] ## Frontma\nSource: nicobailon/pi-prompt-template-model (https://github.com/nicobailon/pi-prompt-template-model)\n\n## feat(coding-agent,tui): support argument-hint frontmatter in prompt templates [...] Parse `argument-hint` from prompt template frontmatter and display it in the autocomplete dropdown, so users can see what arguments a command expects before invoking it. [...] ## Frontmatter format [...] Use ` ` for required arguments and `[square brackets]` for optional ones: [...] ```yaml --- description: Review PRs from URLs with structured issue and code analysis argument-hint: \"<PR-URL>\" --- ``` [...] The\nSource: feat(coding-agent,tui): support argument-hint frontmatter in prompt templates · Pull Request #2780 · badlogic/pi-mono (https://github.com/badlogic/pi-mono/pull/2780)\n\n## Support argument-hint frontmatter in prompt templates [...] ## Feature: Support `argument-hint` frontmatter in prompt templates [...] Parse `argument-hint` from prompt template frontmatter and display it as dim text in the autocomplete dropdown, matching Claude Code's behavior for custom commands. [...] When teams define custom slash commands (e.g., `/review`, `/ship`, `/ticket`), users have no way to discover what arguments the command accepts without reading the source file. Claude Code sol\nSource: Support argument-hint frontmatter in prompt templates · Issue #2761 · badlogic/pi-mono (https://github.com/badlogic/pi-mono/issues/2761)\n\nAdd model, skill, and thinking frontmatter to Pi prompt templates so slash commands switch modes automatically. [...] Pi-prompt-template-model extends Pi's built-in prompt templates with frontmatter like`model`,`skill`, and`thinking`. That lets a template become a reusable agent mode: run a single slash command and Pi can switch to the right model, preload a skill, adjust thinking depth, and restore your previous session settings when the task finishes. [...] The extension also supports more adv\nSource: Prompt Templates — LazyPi Docs (https://lazypi.org/docs/packages/prompt-templates.html)\n\n# pi-prompt-template-model [...] Prompt template model selector extension for pi coding agent [...] npm i pi-prompt-template-model [...] Adds `model`, `skill`, and `thinking` frontmatter to pi prompt templates. Define slash commands that switch to the right model, set a thinking level, inject skill context, and auto-restore your session when done. [...] pi install npm:pi-prompt-template-model [...] Add `model` and optionally `skill` to any prompt template: [...] ## Frontmatter Reference [...] Al\nSource: pi-prompt-template-model (https://registry.npmjs.org/pi-prompt-template-model)\n\nReleases · nicobailon/pi-prompt-template-model · GitHub [...] / pi-prompt-template-model Public [...] v0.7.0 [...] - Added a first-class`bestOfN:` prompt-template authoring surface for compare workflows, with configurable`workers`,`reviewers`, optional`finalApplier`, and nested`bestOfN.worktree` support. - Added configurable compare runtime overrides via`--workers`,`--reviewers`,`--workers-append`,`--reviewers-append`, and`--final-applier`. - Added`count: N` compare-slot shorthand so one worker \nSource: Releases · nicobailon/pi-prompt-template-model · GitHub (https://github.com/nicobailon/pi-prompt-template-model/releases)\n\n# File: nicobailon/pi-prompt-template-model/prompt-execution.ts [...] - Repository: nicobailon/pi-prompt-template-model | Pi extension: Add model frontmatter to prompt templates for automatic model switching | 151 stars | TypeScript - Branch: main [...] ```ts import type { Model } from \"@mariozechner/pi-ai\"; import { substituteArgs } from \"./args.js\"; import { getResolvedModelRef, selectModelCandidate, type RegistryLike, type SelectedModelCandidate } from \"./model-selection.js\"; import type { Pr\nSource: prompt-execution.ts at main · nicobailon/pi-prompt-template-model (https://github.com/nicobailon/pi-prompt-template-model/blob/main/prompt-execution.ts)\n\nRelevant source files [...] * .pi/prompts/is.md * .pi/prompts/pr.md * .pi/prompts/wr.md * packages/coding-agent/docs/prompt-templates.md * packages/coding-agent/docs/skills.md * packages/coding-agent/src/core/package-manager.ts * packages/coding-agent/src/core/prompt-templates.ts * packages/coding-agent/src/core/resource-loader.ts * packages/coding-agent/src/core/skills.ts * packages/coding-agent/src/utils/paths.ts [...] * packages/coding- [...] /test/fixtures/skills/root-skill-preferred/SKILL.m\nSource: Skills & Prompt Templates | badlogic/pi-mono | DeepWiki (https://deepwiki.com/badlogic/pi-mono/4.8-skills-and-prompt-templates)\n\n---\n\n**Sources:**\n1. nicobailon/pi-prompt-template-model\n   https://github.com/nicobailon/pi-prompt-template-model\n\n2. feat(coding