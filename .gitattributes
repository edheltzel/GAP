# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly mark script and config files as text with LF endings
*.ts text eol=lf
*.js text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.vue text eol=lf

# Binary files (don't modify)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary

# The exact recovered native skill and agent snapshot preserves upstream whitespace.
claude/.claude/skills/** whitespace=-blank-at-eol,-blank-at-eof
claude/.claude/agents/** whitespace=-blank-at-eol,-blank-at-eof

# Claude settings mutate locally (counts, feedbackSurveyState timestamps) on every
# session. merge=ours keeps local wins on `git pull`. See AGENTS.md "Scope".
claude/.claude/settings.json merge=ours

# Pi and OMP global settings are single-machine config too. Both harnesses rewrite
# local UI/model/package preferences and runtime bookkeeping; local settings win on pull.
pi/.pi/agent/settings.json merge=ours
omp/.omp/agent/config.yml merge=ours

# Jcode rewrites config.toml and mixes portable preferences with machine-local
# theme and generated launch-hotkey state. The clean filter keeps those fields
# out of diffs and commits while leaving Jcode's live writable file intact.
jcode/.jcode/config.toml filter=jcode-config
