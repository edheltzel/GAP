# Stow defaults (REQUIRED — this file replaces built-in defaults)
\.git
\.gitignore
\.gitmodules
\.gitattributes
.+~
\#.*\#

# macOS
\.DS_Store

# Dependencies
node_modules/
scripts/

# Templates (not needed at runtime)
\.env\.example

# Repo-only files (not needed in ~/.claude at runtime)
\.claude/_archived
\.claude/README\.md
\.claude/install\.sh
\.claude/PAI-Install
\.claude/atlas-statusline\.test\.sh

# PAI v5.0.0 runtime carve-outs (never link these into ~/)
\.claude/PAI/USER/CREDENTIALS
\.claude/PAI/MEMORY/KNOWLEDGE/_embeddings
\.claude/PAI/MEMORY/KNOWLEDGE/_harvest-queue

# auth.json equivalents — Atlas/PAI internal secrets
\.claude/.*\.env
\.claude/.*auth\.json
\.claude/.*\.sqlite.*
