{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "agent": {
    "plan": {
      "model": "opencode-go/glm-5"
    },
    "build": {
      "model": "opencode-go/kimi-k2.5"
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "recall-memory": {
      "type": "local",
      "command": [
        "/Users/ed/.bun/bin/bun",
        "run",
        "/Users/ed/Developer/atlas-recall/dist/mcp-server.js"
      ],
      "enabled": true
    },
    "pencil": {
      "command": [
        "/Applications/Pencil.app/Contents/Resources/app.asar.unpacked/out/mcp-server-darwin-arm64",
        "--app",
        "desktop"
      ],
      "enabled": true,
      "type": "local"
    }
  },
  "instructions": ["AGENTS.md"],
  "plugin": [
    "@tarquinen/opencode-dcp@latest"
  ],
  "tools": {
    "bash": true,
    "edit": true,
    "glob": true,
    "grep": true,
    "read": true,
    "task": true,
    "todoread": true,
    "todowrite": true,
    "webfetch": true,
    "write": true
