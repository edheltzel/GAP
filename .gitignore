# macOS
.DS_Store
._*

# Environment files
.env
.env.local
.env.*.local
*.env

# API keys and secrets
*.pem
*.key
*.cert
*.p12
*.pfx
*_rsa
*_rsa.pub
*.crt
*.cer

# Node/Bun
node_modules/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Stow (root-level only — per-package .stow-local-ignore files ARE tracked)
/.stow-local-ignore

# PAI runtime memory (recreated dynamically by hooks)
claudecode/.claude/MEMORY/**
!claudecode/.claude/MEMORY/README.md

# Claude Code worktrees (auto-generated per-project)
.claude/worktrees/

# Atlas plan files (Claude Code plansDirectory)
.atlas-plans/

# PAI Update System (sideloading)
claudecode/.claude/pai_updates/
claudecode/.claude/pai_backups/
claudecode/.claude/.pai-sync-history
.todos/

# Runtime/sidecar state
.sidecar/
claudecode/.claude/.sidecar/

# Compiled app bundles (build from source via MenuBarApp/build.sh)
claudecode/.claude/Observability/MenuBarApp/Observability.app/

# Superpowers plugin (managed independently by each coding agent)
opencode/.config/opencode/superpowers/
