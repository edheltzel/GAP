.DS_Store
._*

# API keys and secrets
.env
.env.local
.env.*.local
*.env
*.pem
*.key
*.cert
*.p12
*.pfx
*_rsa
*_rsa.pub
*.crt
*.cer

# Node/Bun
node_modules/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Atlas project-local artifacts
.claude/worktrees/
.agents/atlas/worktrees
.atlas/worktrees/

# Pi agent runtime state (never commit)
**/auth.json
**/.update-check
**/.pi-settings.json
pi/.pi/agent/autoresearch.jsonl
pi/.pi/agent/mcp.json
pi/.pi/agent/mcp-cache.json
pi/.pi/agent/run-history.jsonl
pi/.pi/agent/cache/
pi/.pi/agent/sessions/
pi/.pi/agent/memory/
pi/.pi/agent/settings.json.lazypi.*.bak
pi/.pi/agent/*.lazypi.*.bak
pi/.pi/agent/compound-engineering/legacy-backup/
pi/.pi/agent/npm/*
!pi/.pi/agent/npm/.gitignore
pi/.pi/agent/git/*
!pi/.pi/agent/git/.gitignore
# Recall installs these as local runtime symlinks/files under ~/.pi/agent
pi/.pi/agent/Recall_GUIDE.md
pi/.pi/agent/extensions/RecallExtract.ts
pi/.pi/agent/extensions/RecallPreCompact.ts

# Codex runtime state (never commit)
codex/.codex/history.jsonl
codex/.codex/installation_id
codex/.codex/models_cache.json
codex/.codex/version.json
codex/.codex/.personality_migration
codex/.codex/*.sqlite*
codex/.codex/cache/
codex/.codex/log/
codex/.codex/sessions/
codex/.codex/shell_snapshots/
codex/.codex/tmp/
codex/.codex/.tmp/
codex/.codex/skills/.system/

# OMP runtime state (never commit)
omp/.omp/install-id
omp/.omp/.env
omp/.omp/agent/.env
omp/.omp/agent/secrets.yml
omp/.omp/agent/agent.db*
omp/.omp/agent/history.db*
omp/.omp/agent/models.db*
omp/.omp/agent/sessions/
omp/.omp/agent/blobs/
omp/.omp/agent/terminal-sessions/
omp/.omp/agent/memories/
omp/.omp/agent/cache/
omp/.omp/cache/
omp/.omp/auth-broker.token
omp/.omp/auth-gateway.token

# Local backups containing secrets — never commit
oldSetup/
.audit-backup/

# PAI v5.0.0 USER/MEMORY runtime artifacts (slip-through guards — re-state because
# ~/.claude/.gitignore patterns are rooted at ~/.claude and don't match from atlas-config root)
claudecode/.claude/PAI/USER/CREDENTIALS/
claudecode/.claude/PAI/MEMORY/KNOWLEDGE/_embeddings/
claudecode/.claude/PAI/MEMORY/KNOWLEDGE/_harvest-queue/
claudecode/.claude/PAI/MEMORY/WORK/**/.checkpoint-state.json

# Recall MCP DB — lives in ~/.agents/atlas/Recall/, NEVER in atlas-config
claudecode/.claude/memory.db*
**/memory.db
**/memory.db-shm
**/memory.db-wal

# R3 (v1.5): Recall MEMORY/ vault lives in ~/.agents/atlas/Recall/MEMORY/; ~/.claude/MEMORY is a
# symlink to that runtime dir. Only the Atlas-Recall identity card is tracked in atlas-config.
claudecode/.claude/MEMORY/*
!claudecode/.claude/MEMORY/identity.md
