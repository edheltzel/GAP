.env
.env.local
.env.*.local
*.env
*.pem
*.key
*.cert
*.p12
*.pfx
*_rsa
*_rsa.pub
*.crt
*.cer

# Node/Bun
node_modules/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Atlas project-local artifacts — entire folder is local-only (plans, handoffs, artifacts, worktrees)
.claude/worktrees/
.agents/atlas/
.atlas/worktrees/

# Local runtime state (never commit) — gh CLI state, mnemopi memory-bank DBs
.local/
banks/

# Pi agent runtime state (never commit)
**/auth.json
**/.update-check
**/.pi-settings.json
pi/.pi/agent/autoresearch.jsonl
pi/.pi/agent/mcp.json
pi/.pi/agent/mcp-cache.json
pi/.pi/agent/run-history.jsonl
pi/.pi/agent/cache/
pi/.pi/agent/sessions/
pi/.pi/agent/memory/
pi/.pi/agent/settings.json.lazypi.*.bak
pi/.pi/agent/*.lazypi.*.bak
pi/.pi/agent/compound-engineering/legacy-backup/
# Skills installed via skills.sh / Compound Engineering are package-managed runtime files
pi/.pi/agent/agents/ce-*.md
pi/.pi/agent/skills/ce-*/
pi/.pi/agent/skills/lfg/
pi/.pi/agent/compound-engineering/
pi/.pi/agent/npm/*
!pi/.pi/agent/npm/.gitignore
pi/.pi/agent/git/*
!pi/.pi/agent/git/.gitignore
# Recall installs these as local runtime symlinks/files under ~/.pi/agent
pi/.pi/agent/Recall_GUIDE.md
pi/.pi/agent/extensions/RecallExtract.ts
pi/.pi/agent/extensions/RecallPreCompact.ts

# OMP runtime state (never commit)
omp/.omp/install-id
omp/.omp/.env
omp/.omp/agent/.env
omp/.omp/agent/secrets.yml
omp/.omp/agent/agent.db*
omp/.omp/agent/history.db*
omp/.omp/agent/models.db*
omp/.omp/agent/sessions/
omp/.omp/agent/blobs/
omp/.omp/agent/terminal-sessions/
omp/.omp/agent/memories/
omp/.omp/agent/cache/
omp/.omp/cache/
omp/.omp/auth-broker.token
omp/.omp/auth-gateway.token

# Local backups containing secrets — never commit
oldSetup/
.audit-backup/

# Claude USER/MEMORY runtime artifacts (slip-through guards — re-state because
# ~/.claude/.gitignore patterns are rooted at ~/.claude and do not match here)
claude/.claude/PAI/USER/CREDENTIALS/
claude/.claude/PAI/MEMORY/KNOWLEDGE/_embeddings/
claude/.claude/PAI/MEMORY/KNOWLEDGE/_harvest-queue/
claude/.claude/PAI/MEMORY/WORK/**/.checkpoint-state.json

# Recall runtime state lives outside atlas-config. Keep legacy DB spillover and
# the Claude Markdown mirror out of both git and the stow package.
claude/.claude/memory.db*
**/memory.db
**/memory.db-shm
**/memory.db-wal
claude/.claude/MEMORY/
