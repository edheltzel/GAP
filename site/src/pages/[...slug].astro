---
import DocsLayout from "../layouts/DocsLayout.astro";
import {
  getDocsStaticPaths,
  getDocsPage,
  getRouteFlags,
  getSidebar,
  getPrevNext,
  getBreadcrumbs,
  getEditUrl,
  getLastUpdated,
  getTOC,
  stripBase,
} from "@cloudflare/nimbus-docs/runtime";
import { components } from "../components";
import { ogImage, siteName } from "../site.js";

export const getStaticPaths = getDocsStaticPaths;

const page = await getDocsPage(Astro);
if (page instanceof Response) return page;
const { entry, Content, headings, markdownUrl } = page;

const currentSlug = stripBase(Astro.url.pathname, import.meta.env.BASE_URL).replace(/\/$/, "") || "/";

const { sidebar: sidebarOn, tableOfContents: tocOn } = await getRouteFlags(entry);

const sidebar = sidebarOn
  ? await getSidebar(currentSlug, { collection: entry.collection })
  : false;
const prevNext = await getPrevNext(currentSlug, {
  sidebarTree: sidebar === false ? [] : sidebar,
  overrides: { prev: entry.data.prev, next: entry.data.next },
});
// Pass `collection` so versioned pages (docs-<v>) get version-prefixed
// breadcrumb hrefs — parity with the getSidebar call above.
const breadcrumbs = await getBreadcrumbs(currentSlug, { collection: entry.collection });
// Pages live at the repo root, outside site/: `new URL` folds `site/../`.
const rawEditUrl = await getEditUrl(entry);
const editUrl = rawEditUrl ? new URL(rawEditUrl).href : rawEditUrl;
// Frontmatter wins; git is the fallback.
const lastUpdated = entry.data.lastUpdated ??
  await getLastUpdated(entry);
// `tocOn` already implies `tableOfContents !== false`, but TS can't carry
// that boolean narrowing to the value here — re-check it so `getTOC` only
// ever sees its options object (or undefined), never `false`.
const tocConfig = entry.data.tableOfContents;
const toc = tocOn && tocConfig !== false ? getTOC(headings, tocConfig) : false;
// Every page shares the GAP card in public/og.png; no per-page cards are drawn.
const socialImage = entry.data.socialImage ?? ogImage.path;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const article = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: entry.data.title,
  description: entry.data.description,
  url: canonical,
  mainEntityOfPage: canonical,
  inLanguage: "en",
  image: new URL(ogImage.path, Astro.site).href,
  ...(lastUpdated ? { dateModified: new Date(lastUpdated).toISOString() } : {}),
  author: { "@type": "Person", name: "Ed Heltzel", url: "https://github.com/edheltzel" },
  isPartOf: { "@type": "WebSite", name: siteName, url: new URL("/", Astro.site).href },
});
const head = [
  ...(entry.data.head ?? []),
  { tag: "script" as const, attrs: { type: "application/ld+json" }, content: article.replaceAll("<", "\\u003c") },
];
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  sidebar={sidebar}
  headings={toc}
  breadcrumbs={breadcrumbs}
  prevNext={prevNext}
  mode={entry.data.mode}
  banner={entry.data.banner}
  head={head}
  searchable={entry.data.searchable}
  noindex={entry.data.noindex}
  markdownUrl={markdownUrl}
  socialImage={socialImage}
  lastUpdated={lastUpdated}
  editUrl={editUrl}
  draft={entry.data.draft}
  audience={entry.data.audience}
  collection={entry.collection}
  entryId={entry.id}
>
  <Content components={components} />
</DocsLayout>
